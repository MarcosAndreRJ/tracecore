@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro Inesperado — TraceCore";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="tc-card p-5 text-center">
            <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-warning-subtle text-warning mb-3">
                <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>
            <h1 class="tc-title-page fs-3 mb-2">Ocorreu um Erro Inesperado</h1>
            <p class="tc-body text-muted mb-4">
                Não foi possível processar a requisição no momento. A falha foi registrada internamente para análise da equipe de confiabilidade.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded border text-center font-monospace small mb-4">
                    <span class="text-muted">Identificador da Requisição (Request ID):</span>
                    <strong class="text-dark d-block mt-1">@Model.RequestId</strong>
                </div>
            }

            <div class="d-flex align-items-center justify-content-center gap-3">
                <a asp-page="/Index" class="tc-btn tc-btn-primary">
                    <i class="bi bi-house-door me-1"></i>
                    <span>Retornar ao Dashboard</span>
                </a>
            </div>
        </div>
    </div>
</div>
