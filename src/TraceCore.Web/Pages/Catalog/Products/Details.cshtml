@page "{id:long}"
@using TraceCore.Application.DTOs
@model TraceCore.Web.Pages.Catalog.Products.DetailsModel
@{
    ViewData["Title"] = $"{Model.Product?.Name} - Contexto Técnico - TraceCore";
    var activeTab = Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "general";
    var ctx = Model.Context;
}

<div class="tc-breadcrumb">
    <span class="tc-breadcrumb-item"><a asp-page="/Index">Início</a></span>
    <span class="tc-breadcrumb-item"><a asp-page="/Catalog/Products/Index">Sistemas</a></span>
    <span class="tc-breadcrumb-item active">@Model.Product?.Name</span>
</div>

<div class="tc-page-header">
    <div>
        <h1 class="tc-page-header-title">
            <i class="bi bi-laptop text-primary" aria-hidden="true"></i>
            <span>@Model.Product?.Name</span>
        </h1>
        <p class="tc-page-header-subtitle">Contexto técnico de investigação — usado pelo Copiloto para entender arquitetura, tecnologias e fontes desta aplicação</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="tc-alert tc-alert-success mb-4" role="alert"><i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="tc-alert tc-alert-danger mb-4" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage</div>
}

<div class="tc-tabs">
    <ul class="tc-tabs-nav" role="tablist">
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "general" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab">
                <i class="bi bi-card-text"></i><span>Geral</span>
            </button>
        </li>
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "versions" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-versions" type="button" role="tab">
                <i class="bi bi-tags"></i><span>Versões</span>
                <span class="tc-tab-badge">@Model.Versions.Count</span>
            </button>
        </li>
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "technical" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-technical" type="button" role="tab">
                <i class="bi bi-diagram-3"></i><span>Contexto Técnico</span>
            </button>
        </li>
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "components" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-components" type="button" role="tab">
                <i class="bi bi-cpu"></i><span>Componentes</span>
                <span class="tc-tab-badge">@(ctx?.Components.Count ?? 0)</span>
            </button>
        </li>
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "dependencies" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-dependencies" type="button" role="tab">
                <i class="bi bi-bezier2"></i><span>Dependências</span>
                <span class="tc-tab-badge">@(ctx?.Dependencies.Count ?? 0)</span>
            </button>
        </li>
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "integrations" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-integrations" type="button" role="tab">
                <i class="bi bi-arrow-left-right"></i><span>Integrações</span>
                <span class="tc-tab-badge">@(ctx?.Integrations.Count ?? 0)</span>
            </button>
        </li>
        <li class="tc-tab-item">
            <button class="tc-tab-link @(activeTab == "sources" || activeTab == "research" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-sources" type="button" role="tab">
                <i class="bi bi-journal-bookmark"></i><span>Fontes</span>
                <span class="tc-tab-badge">@(ctx?.TechnicalSources.Count ?? 0)</span>
            </button>
        </li>
    </ul>

    <div class="tab-content tc-tab-content">
        <!-- GERAL -->
        <div class="tab-pane fade @(activeTab == "general" ? "show active" : "")" id="tab-general" role="tabpanel">
            <div class="tc-card">
                <div class="tc-card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Código</dt>
                        <dd class="col-sm-9 font-monospace">@(Model.Product?.Code ?? "-")</dd>
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.Product?.Status == "Active")
                            {
                                <span class="tc-badge tc-badge-open">Ativo</span>
                            }
                            else
                            {
                                <span class="tc-badge tc-badge-closed">Inativo</span>
                            }
                        </dd>
                        <dt class="col-sm-3">Origem</dt>
                        <dd class="col-sm-9">
                            @if (Model.Product?.IsExternal == true)
                            {
                                <span class="tc-badge tc-badge-warning"><i class="bi bi-cloud-arrow-down me-1"></i>Externo (Terceiro)</span>
                            }
                            else
                            {
                                <span class="tc-badge tc-badge-verified"><i class="bi bi-building me-1"></i>Interno</span>
                            }
                        </dd>
                        <dt class="col-sm-3">Descrição</dt>
                        <dd class="col-sm-9">@(Model.Product?.Description ?? "Sem descrição")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- VERSÕES -->
        <div class="tab-pane fade @(activeTab == "versions" ? "show active" : "")" id="tab-versions" role="tabpanel">
            <div class="tc-card">
                <div class="tc-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="tc-card-title mb-0">Versões do Sistema</h2>
                        <span class="tc-caption text-muted">Registre as versões liberadas para rastrear se um problema aparece em uma versão específica ou em várias</span>
                    </div>
                    <button type="button" class="tc-btn tc-btn-primary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#addVersionModal">
                        <i class="bi bi-plus-lg me-1"></i>Nova Versão
                    </button>
                </div>
                <div class="tc-card-body p-0">
                    @if (Model.Versions.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            Nenhuma versão registrada para este sistema.
                            <button type="button" class="tc-btn tc-btn-primary tc-btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#addVersionModal"><i class="bi bi-plus-lg me-1"></i>Nova Versão</button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="tc-table">
                                <thead>
                                    <tr>
                                        <th>Ordem</th>
                                        <th>Versão</th>
                                        <th>Lançamento</th>
                                        <th>Status</th>
                                        <th>Casos Ocorridos</th>
                                        <th>Correções</th>
                                        <th>Adoção / Rollout</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Model.Versions)
                                    {
                                        var changeCount = Model.ChangesByVersion.TryGetValue(v.Id, out var chg) ? chg.Count : 0;
                                        var ind = Model.IndicatorsByVersion.TryGetValue(v.Id, out var ibv) ? ibv : null;
                                        var casesOccurred = ind?.CasesOccurredCount ?? 0;
                                        var publishedFixes = ind?.PublishedFixesCount ?? 0;
                                        var deployedClients = ind?.DeployedClientsCount ?? 0;
                                        var pendingClients = ind?.PendingClientsCount ?? 0;

                                        <tr>
                                            <td class="text-muted">@v.ReleaseOrder</td>
                                            <td class="fw-semibold text-dark font-monospace">
                                                @v.VersionLabel
                                                @if (changeCount > 0)
                                                {
                                                    <span class="tc-badge tc-badge-neutral ms-1">@changeCount item(ns)</span>
                                                }
                                            </td>
                                            <td>@(v.ReleasedAt?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td><span class="tc-badge tc-badge-verified">@v.Status</span></td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@casesOccurred caso(s)</span>
                                            </td>
                                            <td>
                                                @if (publishedFixes > 0)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@publishedFixes correção(ões)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">0</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success-subtle text-success">@deployedClients atualizado(s)</span>
                                                @if (pendingClients > 0)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis ms-1">@pendingClients pendente(s)</span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="collapse" data-bs-target="#versionDetails-@v.Id">
                                                    <i class="bi bi-list-ul me-1"></i>Detalhar
                                                </button>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="8" class="p-0 border-0">
                                                <div class="collapse" id="versionDetails-@v.Id">
                                                    <div class="p-3 border-top">
                                                        @{
                                                            var changes = Model.ChangesByVersion.TryGetValue(v.Id, out var ch) ? ch : new List<ProductVersionChangeDto>();
                                                            var assignments = Model.AssignmentsByVersion.TryGetValue(v.Id, out var asg) ? asg : new List<ProductVersionAssignmentDto>();
                                                            var linkedCases = Model.LinkedCasesByVersion.TryGetValue(v.Id, out var lkList) ? lkList : new List<VersionLinkedCaseDetailDto>();
                                                        }

                                                        <!-- Cards de Indicadores da Versão -->
                                                        <div class="row g-2 mb-3">
                                                            <div class="col-md-2 col-6">
                                                                <div class="p-2 border rounded bg-light text-center">
                                                                    <div class="tc-caption text-muted">Casos na Versão</div>
                                                                    <div class="fs-5 fw-bold text-dark">@(ind?.CasesOccurredCount ?? 0)</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2 col-6">
                                                                <div class="p-2 border rounded bg-light text-center">
                                                                    <div class="tc-caption text-muted">Correções</div>
                                                                    <div class="fs-5 fw-bold text-primary">@(ind?.PublishedFixesCount ?? 0)</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2 col-6">
                                                                <div class="p-2 border rounded bg-light text-center">
                                                                    <div class="tc-caption text-muted">Casos Vinculados</div>
                                                                    <div class="fs-5 fw-bold text-dark">@(ind?.LinkedCasesCount ?? 0)</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2 col-6">
                                                                <div class="p-2 border rounded bg-light text-center">
                                                                    <div class="tc-caption text-muted">Planejados</div>
                                                                    <div class="fs-5 fw-bold text-secondary">@(ind?.PlannedClientsCount ?? 0)</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2 col-6">
                                                                <div class="p-2 border rounded bg-light text-center">
                                                                    <div class="tc-caption text-muted">Atualizados</div>
                                                                    <div class="fs-5 fw-bold text-success">@(ind?.DeployedClientsCount ?? 0)</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2 col-6">
                                                                <div class="p-2 border rounded bg-light text-center">
                                                                    <div class="tc-caption text-muted">Pendentes</div>
                                                                    <div class="fs-5 fw-bold text-warning">@(ind?.PendingClientsCount ?? 0)</div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Navegação por Abas dentro do Detalhe da Versão -->
                                                        <ul class="nav nav-tabs mb-3" id="vtabs-@v.Id" role="tablist">
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link active py-1 px-3" id="vtab-changes-tab-@v.Id" data-bs-toggle="tab" data-bs-target="#vtab-changes-@v.Id" type="button" role="tab">
                                                                    <i class="bi bi-journal-text me-1"></i>Alterações (@changes.Count)
                                                                </button>
                                                            </li>
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link py-1 px-3" id="vtab-cases-tab-@v.Id" data-bs-toggle="tab" data-bs-target="#vtab-cases-@v.Id" type="button" role="tab">
                                                                    <i class="bi bi-link-45deg me-1"></i>Casos (@linkedCases.Count)
                                                                </button>
                                                            </li>
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link py-1 px-3" id="vtab-rollout-tab-@v.Id" data-bs-toggle="tab" data-bs-target="#vtab-rollout-@v.Id" type="button" role="tab">
                                                                    <i class="bi bi-send me-1"></i>Implantação por Cliente (@assignments.Count)
                                                                </button>
                                                            </li>
                                                        </ul>

                                                        <div class="tab-content" id="vtabsContent-@v.Id">
                                                            <!-- ABA 1: ALTERAÇÕES -->
                                                            <div class="tab-pane fade show active" id="vtab-changes-@v.Id" role="tabpanel">
                                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                                    <h6 class="tc-card-title mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Itens desta versão (alterações / releases)</h6>
                                                                    <button type="button" class="tc-btn tc-btn-primary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddChange" onclick="openAddChangeModal('@v.Id', '@v.VersionLabel')">
                                                                        <i class="bi bi-plus-lg me-1"></i>Nova Alteração
                                                                    </button>
                                                                </div>

                                                                @if (changes.Count == 0)
                                                                {
                                                                    <p class="tc-caption text-muted mb-0">Nenhum item registrado nesta versão ainda.</p>
                                                                }
                                                                else
                                                                {
                                                                    @foreach (var c in changes)
                                                                    {
                                                                        <div class="tc-alert tc-alert-info mb-3">
                                                                            <div class="d-flex justify-content-between align-items-start">
                                                                                <div>
                                                                                    <span class="tc-badge tc-badge-primary me-2">@c.ChangeTypeLabel</span>
                                                                                    <span class="fw-semibold">@c.Title</span>
                                                                                    @if (!string.IsNullOrEmpty(c.ErrorCode))
                                                                                    {
                                                                                        <span class="tc-badge tc-badge-neutral ms-1">@c.ErrorCode</span>
                                                                                    }
                                                                                    @if (!string.IsNullOrEmpty(c.ComponentName))
                                                                                    {
                                                                                        <span class="tc-caption text-muted d-block">Componente: @c.ComponentName</span>
                                                                                    }
                                                                                    @if (!string.IsNullOrEmpty(c.Description))
                                                                                    {
                                                                                        <div class="tc-caption text-muted">@c.Description</div>
                                                                                    }

                                                                                    <!-- Observação factual de recorrência pós-release para Correções (Fase 5) -->
                                                                                    @if (string.Equals(c.ChangeType, "Fix", StringComparison.OrdinalIgnoreCase) && Model.RecurrenceByChangeId.TryGetValue(c.Id, out var rec))
                                                                                    {
                                                                                        <div class="p-2 mt-2 rounded bg-light border text-dark small">
                                                                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                                                                <span><i class="bi bi-clock-history me-1 text-primary"></i><strong>Casos históricos relacionados:</strong> @rec.HistoricalCasesCount</span>
                                                                                                <span><i class="bi bi-people me-1 text-success"></i><strong>Clientes atualizados:</strong> @rec.DeployedClientsCount</span>
                                                                                                <span class="badge bg-light text-dark border"><i class="bi bi-info-circle me-1 text-muted"></i>@rec.ObservationMessage</span>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    @if (c.LinkedCases.Count > 0)
                                                                                    {
                                                                                        var resolvedCount = c.LinkedCases.Count(l => string.Equals(l.CaseStatus, "Resolved", StringComparison.OrdinalIgnoreCase));
                                                                                        var openCount = c.LinkedCases.Count - resolvedCount;
                                                                                        <div class="mt-2 pt-2 border-top">
                                                                                            <div class="d-flex align-items-center gap-2 mb-1 small text-muted">
                                                                                                <span><i class="bi bi-link-45deg me-1"></i><strong>Casos vinculados:</strong> @c.LinkedCases.Count</span>
                                                                                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Resolvidos: @resolvedCount</span>
                                                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-clock-history me-1"></i>Abertos: @openCount</span>
                                                                                            </div>
                                                                                            <div class="d-flex flex-wrap gap-1 align-items-center mt-1">
                                                                                                @foreach (var lk in c.LinkedCases)
                                                                                                {
                                                                                                    <span class="tc-badge tc-badge-verified d-inline-flex align-items-center me-1">
                                                                                                        <a href="/Cases/Details?id=@lk.CaseId" class="text-decoration-none me-1" target="_blank">#@lk.CaseNumber</a>
                                                                                                        <span class="text-muted small">(@lk.RelationTypeLabel@(string.IsNullOrEmpty(lk.CaseStatus) ? "" : $" - {lk.CaseStatus}"))</span>
                                                                                                        <form method="post" asp-page-handler="UnlinkCase" asp-route-id="@Model.Product?.Id" asp-route-changeId="@c.Id" asp-route-caseId="@lk.CaseId" asp-route-relationType="@lk.RelationType" class="d-inline ms-1">
                                                                                                            <button type="submit" class="btn btn-sm btn-link p-0 text-danger" title="Desvincular caso"><i class="bi bi-x-lg"></i></button>
                                                                                                        </form>
                                                                                                    </span>
                                                                                                }
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                            <form method="post" asp-page-handler="LinkCase" asp-route-id="@Model.Product?.Id" class="d-flex gap-2 align-items-center mt-2 pt-2 border-top">
                                                                                <input type="hidden" asp-for="NewCaseLink.ChangeId" value="@c.Id" />
                                                                                <div class="form-group mb-0" style="max-width: 220px;">
                                                                                    <input type="number" class="tc-input tc-input-sm" asp-for="NewCaseLink.CaseNumber" placeholder="Vincular caso por nº..." min="1" required />
                                                                                </div>
                                                                                <div class="form-group mb-0" style="max-width: 180px;">
                                                                                    <select class="tc-select tc-select-sm" asp-for="NewCaseLink.RelationType">
                                                                                        @foreach (var t in Model.ValidRelationTypes)
                                                                                        {
                                                                                            <option value="@t">@TraceCore.Domain.Entities.ProductVersionChangeCase.Label(t)</option>
                                                                                        }
                                                                                    </select>
                                                                                </div>
                                                                                <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm py-1"><i class="bi bi-link-45deg me-1"></i>Vincular</button>
                                                                            </form>
                                                                        </div>
                                                                    }
                                                                }
                                                            </div>

                                                            <!-- ABA 2: CASOS VINCULADOS À VERSÃO (Fase 5) -->
                                                            <div class="tab-pane fade" id="vtab-cases-@v.Id" role="tabpanel">
                                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                                    <h6 class="tc-card-title mb-0"><i class="bi bi-link-45deg me-2 text-primary"></i>Casos Vinculados às Alterações da Versão</h6>
                                                                </div>

                                                                @if (linkedCases.Count == 0)
                                                                {
                                                                    <p class="tc-caption text-muted mb-0">Nenhum caso vinculado às alterações desta versão ainda.</p>
                                                                }
                                                                else
                                                                {
                                                                    <div class="table-responsive">
                                                                        <table class="tc-table tc-table-sm">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>Correção</th>
                                                                                    <th>Caso Vinculado</th>
                                                                                    <th>Status</th>
                                                                                    <th>Cliente</th>
                                                                                    <th>Versão onde ocorreu</th>
                                                                                    <th>Relação</th>
                                                                                    <th>Data Vínculo</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var lc in linkedCases)
                                                                                {
                                                                                    <tr>
                                                                                        <td class="fw-semibold">
                                                                                            <span class="tc-badge tc-badge-primary me-1">@lc.ChangeTypeLabel</span>
                                                                                            @lc.ChangeTitle
                                                                                        </td>
                                                                                        <td>
                                                                                            <a href="/Cases/Details?id=@lc.CaseId" class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none" target="_blank">
                                                                                                #@lc.CaseNumber
                                                                                            </a>
                                                                                            <span class="small d-block text-muted">@lc.CaseTitle</span>
                                                                                        </td>
                                                                                        <td>
                                                                                            <span class="badge @(lc.CaseStatus == "Resolved" ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">@lc.CaseStatus</span>
                                                                                        </td>
                                                                                        <td>@(lc.ClientName ?? "—")</td>
                                                                                        <td>
                                                                                            @if (!string.IsNullOrEmpty(lc.OccurredInVersionLabel))
                                                                                            {
                                                                                                <span class="badge bg-light text-dark border font-monospace">v@lc.OccurredInVersionLabel</span>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span class="text-muted small">Sem versão</span>
                                                                                            }
                                                                                        </td>
                                                                                        <td><span class="badge bg-info-subtle text-info-emphasis border">@lc.RelationTypeLabel</span></td>
                                                                                        <td class="small text-muted">@lc.LinkedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                            </div>

                                                            <!-- ABA 3: ROLLOUT / IMPLANTAÇÃO -->
                                                            <div class="tab-pane fade" id="vtab-rollout-@v.Id" role="tabpanel">
                                                                <h6 class="tc-card-title mb-2"><i class="bi bi-send me-2 text-primary"></i>Destinação / rollout para clientes</h6>
                                                                <form method="post" asp-page-handler="CreateAssignment" asp-route-id="@Model.Product?.Id">
                                                                    <input type="hidden" asp-for="NewAssignment.VersionId" value="@v.Id" />
                                                                    <div class="row g-2 mb-2">
                                                                        <div class="col-md-3">
                                                                            <select class="tc-select" asp-for="NewAssignment.ClientId">
                                                                                <option value="">Selecione o cliente...</option>
                                                                                @foreach (var cl in Model.ClientsForRollout)
                                                                                {
                                                                                    <option value="@cl.Id">@cl.Name</option>
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <select class="tc-select" asp-for="NewAssignment.ClientUnitId">
                                                                                <option value="">Cliente inteiro (sem unidade)</option>
                                                                                @foreach (var cl in Model.ClientsForRollout)
                                                                                {
                                                                                    @foreach (var u in Model.UnitsByClient.TryGetValue(cl.Id, out var ul) ? ul : new List<ClientUnitDto>())
                                                                                    {
                                                                                        <option value="@u.Id">@cl.Name — @u.Name</option>
                                                                                    }
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                        <div class="col-md-4">
                                                                            <input type="text" class="tc-input" asp-for="NewAssignment.Notes" placeholder="Observações (opcional)" />
                                                                        </div>
                                                                        <div class="col-md-2">
                                                                            <button type="submit" class="tc-btn tc-btn-primary tc-btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>Destinar</button>
                                                                        </div>
                                                                    </div>
                                                                    <span class="tc-caption text-muted">Criar uma destinação NÃO altera a versão corrente do cliente. Somente ao confirmar o deploy a versão é atualizada.</span>
                                                                </form>

                                                                @if (assignments.Count == 0)
                                                                {
                                                                    <p class="tc-caption text-muted mb-0">Nenhuma destinação registrada para esta versão.</p>
                                                                }
                                                                else
                                                                {
                                                                    <div class="table-responsive mt-2">
                                                                        <table class="tc-table tc-table-sm">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>Cliente</th>
                                                                                    <th>Unidade</th>
                                                                                    <th>Status</th>
                                                                                    <th>Agendado</th>
                                                                                    <th>Implantado</th>
                                                                                    <th></th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var a in assignments)
                                                                                {
                                                                                    var clientContexts = Model.ClientContextsMap.TryGetValue(a.ClientId, out var cc) ? cc : new List<ClientTechnicalContextDto>();
                                                                                    var activeCtxs = clientContexts
                                                                                        .Where(c => (c.ClientUnitId ?? 0) == (a.ClientUnitId ?? 0) && c.EffectiveTo == null)
                                                                                        .ToList();
                                                                                    var currentVersionLabel = activeCtxs.FirstOrDefault()?.VersionLabel ?? "Não definida";
                                                                                    var envsList = activeCtxs.Where(c => c.EnvironmentId.HasValue).Select(c => new { id = c.EnvironmentId!.Value, name = c.EnvironmentName ?? $"Ambiente #{c.EnvironmentId}" }).Distinct().ToList();
                                                                                    var clientActiveEnvsJson = System.Text.Json.JsonSerializer.Serialize(envsList);

                                                                                    <tr>
                                                                                        <td class="fw-semibold">@a.ClientName</td>
                                                                                        <td>@(a.ClientUnitName ?? "—")</td>
                                                                                        <td>
                                                                                            @if (a.Status == "Deployed")
                                                                                            {
                                                                                                <span class="tc-badge tc-badge-verified">@a.StatusLabel</span>
                                                                                            }
                                                                                            else if (a.Status == "Failed")
                                                                                            {
                                                                                                <span class="tc-badge tc-badge-danger">@a.StatusLabel</span>
                                                                                            }
                                                                                            else if (a.Status == "Scheduled")
                                                                                            {
                                                                                                <span class="tc-badge tc-badge-primary">@a.StatusLabel</span>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span class="tc-badge tc-badge-neutral">@a.StatusLabel</span>
                                                                                            }
                                                                                        </td>
                                                                                        <td>@(a.ScheduledAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                                                                        <td>@(a.DeployedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                                                                        <td class="text-end text-nowrap">
                                                                                            @if (a.Status == "Planned")
                                                                                            {
                                                                                                <button type="button" class="tc-btn tc-btn-primary tc-btn-sm me-1"
                                                                                                        onclick="openConfirmDeployModal('@a.Id', '@a.ClientName', '@(a.ClientUnitName ?? "")', '@Model.Product?.Name', '@currentVersionLabel', '@v.VersionLabel', '@Html.Raw(clientActiveEnvsJson.Replace("'", "\\'"))')">
                                                                                                    <i class="bi bi-check-lg me-1"></i>Confirmar Atualização
                                                                                                </button>
                                                                                                <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm me-1"
                                                                                                        onclick="openScheduleModal('@a.Id', '@a.ClientName', '@v.VersionLabel')">
                                                                                                    <i class="bi bi-calendar-event me-1"></i>Agendar
                                                                                                </button>
                                                                                                <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm me-1 text-danger"
                                                                                                        onclick="openFailModal('@a.Id', '@a.ClientName', '@v.VersionLabel')">
                                                                                                    <i class="bi bi-exclamation-octagon me-1"></i>Falha
                                                                                                </button>
                                                                                                <form method="post" asp-page-handler="RemoveAssignment" asp-route-id="@Model.Product?.Id" asp-route-assignmentId="@a.Id" class="d-inline" onsubmit="return confirm('Deseja realmente remover esta destinação do planejamento?');">
                                                                                                    <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm" title="Remover do planejamento"><i class="bi bi-trash"></i></button>
                                                                                                </form>
                                                                                            }
                                                                                            else if (a.Status == "Scheduled")
                                                                                            {
                                                                                                <button type="button" class="tc-btn tc-btn-primary tc-btn-sm me-1"
                                                                                                        onclick="openConfirmDeployModal('@a.Id', '@a.ClientName', '@(a.ClientUnitName ?? "")', '@Model.Product?.Name', '@currentVersionLabel', '@v.VersionLabel', '@Html.Raw(clientActiveEnvsJson.Replace("'", "\\'"))')">
                                                                                                    <i class="bi bi-check-lg me-1"></i>Confirmar Atualização
                                                                                                </button>
                                                                                                <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm me-1 text-danger"
                                                                                                        onclick="openFailModal('@a.Id', '@a.ClientName', '@v.VersionLabel')">
                                                                                                    <i class="bi bi-exclamation-octagon me-1"></i>Falha
                                                                                                </button>
                                                                                                <form method="post" asp-page-handler="RemoveAssignment" asp-route-id="@Model.Product?.Id" asp-route-assignmentId="@a.Id" class="d-inline" onsubmit="return confirm('Deseja cancelar e remover este agendamento?');">
                                                                                                    <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm" title="Remover agendamento"><i class="bi bi-trash"></i></button>
                                                                                                </form>
                                                                                            }
                                                                                            else if (a.Status == "Deployed")
                                                                                            {
                                                                                                <span class="tc-caption text-success fw-semibold"><i class="bi bi-check2-all me-1"></i>Atualizado</span>
                                                                                            }
                                                                                            else if (a.Status == "Failed" || a.Status == "Skipped")
                                                                                            {
                                                                                                <form method="post" asp-page-handler="ReopenAssignment" asp-route-id="@Model.Product?.Id" asp-route-assignmentId="@a.Id" class="d-inline">
                                                                                                    <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm" title="Retornar destinação para o status Planejado"><i class="bi bi-arrow-counterclockwise me-1"></i>Replanejar</button>
                                                                                                </form>
                                                                                            }
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                             </td>
                                         </tr>
                                     }
                                 </tbody>
                             </table>
                         </div>
                     }
                 </div>
             </div>

             <!-- MODAL: Nova Versão -->
             <div class="modal fade" id="addVersionModal" tabindex="-1" aria-labelledby="addVersionModalLabel" aria-hidden="true">
                 <div class="modal-dialog">
                     <div class="modal-content tc-modal-content">
                         <form method="post" asp-page-handler="AddVersion" asp-route-id="@Model.Product?.Id">
                             <div class="modal-header">
                                 <h5 class="modal-title" id="addVersionModalLabel">
                                     <i class="bi bi-tags me-2 text-primary"></i>Nova Versão
                                 </h5>
                                 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                             </div>
                             <div class="modal-body">
                                 <div class="mb-3">
                                     <label class="form-label fw-semibold" for="newVersionLabel">Rótulo da Versão <span class="text-danger">*</span></label>
                                     <input type="text" id="newVersionLabel" class="tc-input" asp-for="NewVersion.VersionLabel" placeholder="Ex.: 3.6.0" required />
                                 </div>
                                 <div class="mb-3">
                                     <label class="form-label fw-semibold" for="newVersionReleasedAt">Data de Lançamento</label>
                                     <input type="date" id="newVersionReleasedAt" class="tc-input" asp-for="NewVersion.ReleasedAt" />
                                     <span class="tc-caption text-muted d-block mt-1">Opcional — usada para comparar métricas antes/depois desta versão.</span>
                                 </div>
                                 <div class="mb-3">
                                     <label class="form-label fw-semibold">Destinar versão para clientes no lançamento (opcional)</label>
                                     <div class="border rounded p-2" style="max-height: 160px; overflow-y: auto;">
                                         @if (Model.ClientsForRollout.Count == 0)
                                         {
                                             <span class="tc-caption text-muted">Nenhum cliente ativo disponível.</span>
                                         }
                                         else
                                         {
                                             @foreach (var cl in Model.ClientsForRollout)
                                             {
                                                 <div class="form-check form-check-sm mb-1">
                                                     <input class="form-check-input" type="checkbox" name="SelectedClientIdsForRollout" value="@cl.Id" id="rolloutClient_@cl.Id">
                                                     <label class="form-check-label small" for="rolloutClient_@cl.Id">
                                                         @cl.Name
                                                     </label>
                                                 </div>
                                             }
                                         }
                                     </div>
                                     <span class="tc-caption text-muted d-block mt-1">Os clientes selecionados receberão a versão em status 'Planejado'. O deploy poderá ser confirmado individualmente depois.</span>
                                 </div>
                             </div>
                             <div class="modal-footer">
                                 <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                 <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar Versão</button>
                             </div>
                         </form>
                     </div>
                 </div>
             </div>

             <!-- MODAL: Confirmar Deploy -->
             <div class="modal fade" id="modalConfirmDeploy" tabindex="-1" aria-labelledby="modalConfirmDeployLabel" aria-hidden="true">
                 <div class="modal-dialog">
                     <div class="modal-content tc-modal-content">
                         <form method="post" asp-page-handler="ConfirmDeploy" asp-route-id="@Model.Product?.Id">
                             <input type="hidden" name="assignmentId" id="deployAssignmentId" />
                             <div class="modal-header">
                                 <h5 class="modal-title" id="modalConfirmDeployLabel">
                                     <i class="bi bi-cloud-arrow-up text-primary me-2"></i>Confirmar Atualização de Versão
                                 </h5>
                                 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                             </div>
                             <div class="modal-body">
                                 <div class="tc-alert tc-alert-info mb-3">
                                     <i class="bi bi-info-circle me-1"></i>
                                     Ao confirmar o deploy, o contexto técnico atual do cliente será encerrado e um novo contexto técnico será registrado para a nova versão, preservando o histórico de vigência.
                                 </div>
                                 <dl class="row mb-3">
                                     <dt class="col-sm-4 text-muted">Cliente:</dt>
                                     <dd class="col-sm-8 fw-semibold" id="deployClientName">-</dd>
                                     
                                     <dt class="col-sm-4 text-muted">Sistema:</dt>
                                     <dd class="col-sm-8" id="deployProductName">-</dd>
                                     
                                     <dt class="col-sm-4 text-muted">Versão Atual:</dt>
                                     <dd class="col-sm-8" id="deployCurrentVersion">-</dd>
                                     
                                     <dt class="col-sm-4 text-muted">Nova Versão:</dt>
                                     <dd class="col-sm-8 fw-bold text-success font-monospace" id="deployNewVersion">-</dd>
                                 </dl>

                                 <div class="mb-3" id="deployEnvContainer" style="display:none;">
                                     <label class="form-label fw-semibold" for="deployEnvironmentId">Ambiente de Aplicação <span class="text-danger">*</span></label>
                                     <select class="tc-select" name="environmentId" id="deployEnvironmentId">
                                         <option value="">Selecione o ambiente...</option>
                                     </select>
                                     <span class="tc-caption text-muted d-block mt-1">Detectado mais de um ambiente ativo para este cliente. Selecione o ambiente específico.</span>
                                 </div>

                                 <div class="mb-3">
                                     <label class="form-label fw-semibold">Data / Hora Efetiva</label>
                                     <input type="text" class="tc-input" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm") (Imediata)" readonly disabled />
                                 </div>
                             </div>
                             <div class="modal-footer">
                                 <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                 <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-check-lg me-1"></i>Confirmar Deploy</button>
                             </div>
                         </form>
                     </div>
                 </div>
             </div>

             <!-- MODAL: Agendar Atualização -->
             <div class="modal fade" id="modalScheduleAssignment" tabindex="-1" aria-labelledby="modalScheduleLabel" aria-hidden="true">
                 <div class="modal-dialog">
                     <div class="modal-content tc-modal-content">
                         <form method="post" asp-page-handler="ScheduleAssignment" asp-route-id="@Model.Product?.Id">
                             <input type="hidden" name="assignmentId" id="scheduleAssignmentId" />
                             <div class="modal-header">
                                 <h5 class="modal-title" id="modalScheduleLabel">
                                     <i class="bi bi-calendar-event text-primary me-2"></i>Agendar Atualização
                                 </h5>
                                 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                             </div>
                             <div class="modal-body">
                                 <p class="text-muted small mb-3">Defina a data e hora programadas para implantação da versão no cliente.</p>
                                 <dl class="row mb-3">
                                     <dt class="col-sm-4 text-muted">Cliente:</dt>
                                     <dd class="col-sm-8 fw-semibold" id="scheduleClientName">-</dd>
                                     <dt class="col-sm-4 text-muted">Versão:</dt>
                                     <dd class="col-sm-8 font-monospace text-primary" id="scheduleVersionLabel">-</dd>
                                 </dl>
                                 <div class="mb-3">
                                     <label class="form-label fw-semibold" for="scheduleDatetime">Data / Hora Programada <span class="text-danger">*</span></label>
                                     <input type="datetime-local" class="tc-input" name="scheduledAt" id="scheduleDatetime" required />
                                 </div>
                             </div>
                             <div class="modal-footer">
                                 <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                 <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-calendar-check me-1"></i>Salvar Agendamento</button>
                             </div>
                         </form>
                     </div>
                 </div>
             </div>

             <!-- MODAL: Marcar Falha -->
             <div class="modal fade" id="modalFailAssignment" tabindex="-1" aria-labelledby="modalFailLabel" aria-hidden="true">
                 <div class="modal-dialog">
                     <div class="modal-content tc-modal-content">
                         <form method="post" asp-page-handler="FailAssignment" asp-route-id="@Model.Product?.Id">
                             <input type="hidden" name="assignmentId" id="failAssignmentId" />
                             <div class="modal-header">
                                 <h5 class="modal-title text-danger" id="modalFailLabel">
                                     <i class="bi bi-exclamation-triangle-fill me-2"></i>Registrar Falha na Atualização
                                 </h5>
                                 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                             </div>
                             <div class="modal-body">
                                 <dl class="row mb-3">
                                     <dt class="col-sm-4 text-muted">Cliente:</dt>
                                     <dd class="col-sm-8 fw-semibold" id="failClientName">-</dd>
                                     <dt class="col-sm-4 text-muted">Versão:</dt>
                                     <dd class="col-sm-8 font-monospace" id="failVersionLabel">-</dd>
                                 </dl>
                                 <div class="mb-3">
                                     <label class="form-label fw-semibold" for="failNotes">Motivo / Observações da Falha <span class="text-danger">*</span></label>
                                     <textarea class="tc-textarea" name="notes" id="failNotes" rows="3" placeholder="Descreva o motivo da falha ou impedimento técnico..." required></textarea>
                                 </div>
                             </div>
                             <div class="modal-footer">
                                 <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                 <button type="submit" class="tc-btn tc-btn-danger"><i class="bi bi-exclamation-octagon me-1"></i>Confirmar Falha</button>
                             </div>
                         </form>
                     </div>
                 </div>
             </div>

             <!-- MODAL: Nova Alteração (Fase 3 com ranking determinístico de casos) -->
             <div class="modal fade" id="modalAddChange" tabindex="-1" aria-labelledby="modalAddChangeLabel" aria-hidden="true">
                 <div class="modal-dialog modal-lg">
                     <div class="modal-content tc-modal-content">
                         <form method="post" asp-page-handler="AddChange" asp-route-id="@Model.Product?.Id" id="formAddChange">
                             <input type="hidden" asp-for="NewChange.VersionId" id="addChangeVersionId" />
                             <div class="modal-header">
                                 <h5 class="modal-title" id="modalAddChangeLabel">
                                     <i class="bi bi-plus-circle text-primary me-2"></i>Nova Alteração na Versão <span id="addChangeVersionLabel" class="font-monospace text-primary"></span>
                                 </h5>
                                 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                             </div>
                             <div class="modal-body">
                                 <div class="row g-3">
                                     <div class="col-lg-6 border-end pe-lg-3">
                                         <h6 class="tc-card-title mb-2 small text-muted"><i class="bi bi-pencil-square me-1"></i>Dados da Alteração</h6>
                                         <div class="mb-3">
                                             <label class="form-label fw-semibold" for="addChangeType">Tipo da Alteração <span class="text-danger">*</span></label>
                                             <select class="tc-select" asp-for="NewChange.ChangeType" id="addChangeType" required>
                                                 @foreach (var t in Model.ValidChangeTypes)
                                                 {
                                                     <option value="@t">@TraceCore.Domain.Entities.ProductVersionChange.Label(t)</option>
                                                 }
                                             </select>
                                         </div>
                                         <div class="mb-3">
                                             <label class="form-label fw-semibold" for="addChangeTitle">Título <span class="text-danger">*</span></label>
                                             <input type="text" class="tc-input" asp-for="NewChange.Title" id="addChangeTitle" placeholder="Ex.: Corrige timeout no gateway de pagamento" required />
                                         </div>
                                         <div class="mb-3">
                                             <label class="form-label fw-semibold" for="addChangeDescription">Descrição Técnica (opcional)</label>
                                             <textarea class="tc-textarea" asp-for="NewChange.Description" id="addChangeDescription" rows="3" placeholder="Detalhes técnicos, causa raiz ou contexto da modificação..."></textarea>
                                         </div>
                                         <div class="row g-2">
                                             <div class="col-md-6 mb-3">
                                                 <label class="form-label fw-semibold" for="addChangeComponent">Componente</label>
                                                 <select class="tc-select" asp-for="NewChange.ComponentId" id="addChangeComponent">
                                                     <option value="">Selecione...</option>
                                                     @foreach (var comp in Model.AllComponents)
                                                     {
                                                         <option value="@comp.Id">@comp.Name</option>
                                                     }
                                                 </select>
                                             </div>
                                             <div class="col-md-6 mb-3">
                                                 <label class="form-label fw-semibold" for="addChangeErrorCode">Código de Erro</label>
                                                 <input type="text" class="tc-input" asp-for="NewChange.ErrorCode" id="addChangeErrorCode" placeholder="Ex.: ERR_TIMEOUT" />
                                             </div>
                                         </div>
                                     </div>
                                     <div class="col-lg-6 ps-lg-3">
                                         <div class="d-flex justify-content-between align-items-center mb-2">
                                             <h6 class="tc-card-title mb-0 small text-primary">
                                                 <i class="bi bi-magic me-1"></i>Casos Sugeridos (FixedBy)
                                             </h6>
                                             <span class="tc-caption text-muted" id="changeSuggestionStatus">Motor determinístico</span>
                                         </div>
                                         <p class="tc-caption text-muted mb-2">
                                             Casos de versões anteriores com sintomas, componentes ou erros semelhantes. Marque para vincular automaticamente.
                                         </p>
                                         <div id="changeCaseSuggestionsContainer" style="max-height: 380px; overflow-y: auto;">
                                             <div class="tc-empty-state tc-empty-state-compact p-3 border rounded-2 bg-light text-center">
                                                 <div class="tc-empty-icon text-muted mb-1"><i class="bi bi-search fs-4"></i></div>
                                                 <div class="tc-empty-title small fw-semibold text-secondary">Aguardando dados</div>
                                                 <p class="tc-empty-description small text-muted mb-0">Preencha o título para iniciar a busca determinística de casos.</p>
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>
                             <div class="modal-footer">
                                 <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                 <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar Alteração</button>
                             </div>
                         </form>
                     </div>
                 </div>
             </div>
        </div>

        <!-- CONTEXTO TÉCNICO -->
        <div class="tab-pane fade @(activeTab == "technical" ? "show active" : "")" id="tab-technical" role="tabpanel">
            <div class="tc-card mb-4">
                <div class="tc-card-header"><h2 class="tc-card-title mb-0">Contexto Técnico</h2></div>
                <div class="tc-card-body">
                    <form method="post" asp-page-handler="SaveProfile" asp-route-id="@Model.Product?.Id">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo do sistema</label>
                            <select class="tc-select" asp-for="ProfileForm.SystemType">
                                <option value="">Selecione...</option>
                                @foreach (var t in Model.SystemTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                            <span class="tc-caption text-muted d-block mt-1">Ex.: Desktop, Web, Mobile, API, Serviço, SaaS ou Outro.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Finalidade do sistema</label>
                            <textarea class="tc-textarea" asp-for="ProfileForm.BusinessPurpose" rows="2" placeholder="Para que esta aplicação existe..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Resumo da arquitetura</label>
                            <textarea class="tc-textarea" asp-for="ProfileForm.ArchitectureSummary" rows="2" placeholder="Ex.: Frontend Web → API → MySQL"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Frontend</label>
                                <input class="tc-input" asp-for="ProfileForm.FrontendStack" placeholder="Ex.: React, TypeScript" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Backend</label>
                                <input class="tc-input" asp-for="ProfileForm.BackendStack" placeholder="Ex.: .NET 10, ASP.NET Core" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Banco principal</label>
                                <input class="tc-input" asp-for="ProfileForm.PrimaryDatabase" placeholder="Ex.: MySQL 8.4" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Runtime</label>
                                <input class="tc-input" asp-for="ProfileForm.RuntimePlatform" placeholder="Ex.: .NET 10" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Autenticação</label>
                                <input class="tc-input" asp-for="ProfileForm.AuthenticationModel" placeholder="Ex.: OAuth2 / Keycloak" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Hospedagem</label>
                                <input class="tc-input" asp-for="ProfileForm.HostingModel" placeholder="Ex.: Docker / Linux" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Deploy</label>
                                <input class="tc-input" asp-for="ProfileForm.DeploymentModel" placeholder="Ex.: GitHub Actions" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Observabilidade</label>
                                <input class="tc-input" asp-for="ProfileForm.ObservabilityStack" placeholder="Ex.: Grafana, Prometheus" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Fornecedor</label>
                                <input class="tc-input" asp-for="ProfileForm.Vendor" placeholder="Ex.: Interno / SAP / Microsoft" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Restrições conhecidas</label>
                            <textarea class="tc-textarea" asp-for="ProfileForm.KnownConstraints" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Notas para investigação</label>
                            <textarea class="tc-textarea" asp-for="ProfileForm.InvestigationNotes" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Notas de suporte</label>
                            <textarea class="tc-textarea" asp-for="ProfileForm.SupportNotes" rows="2"></textarea>
                        </div>
                        <div class="tc-alert tc-alert-warning mb-3">
                            <i class="bi bi-shield-exclamation me-2"></i>
                            Não informe senhas, tokens, API Keys, connection strings ou outros segredos neste cadastro.
                        </div>
                        <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-save me-1"></i>Salvar Contexto Técnico</button>
                    </form>
                </div>
            </div>

            <div class="tc-card">
                <div class="tc-card-header"><h2 class="tc-card-title mb-0">Tecnologias</h2></div>
                <div class="tc-card-body">
                    <div class="mb-2">
                        @foreach (var t in ctx?.Technologies ?? Array.Empty<string>())
                        {
                            <span class="tc-badge tc-badge-verified me-1 mb-1">@t</span>
                        }
                        @if ((ctx?.Technologies.Count ?? 0) == 0)
                        {
                            <span class="text-muted tc-caption">Nenhuma tecnologia cadastrada.</span>
                        }
                    </div>
                    <form method="post" asp-page-handler="SetTechnologies" asp-route-id="@Model.Product?.Id" class="d-flex gap-2">
                        <input class="tc-input" asp-for="TechnologiesCsv" placeholder="Ex.: .NET, MySQL, Redis, Docker (separadas por vírgula)" />
                        <button type="submit" class="tc-btn tc-btn-secondary text-nowrap"><i class="bi bi-tags me-1"></i>Atualizar</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- COMPONENTES -->
        <div class="tab-pane fade @(activeTab == "components" ? "show active" : "")" id="tab-components" role="tabpanel">
            <div class="tc-card">
                <div class="tc-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="tc-card-title mb-0">Componentes do Sistema</h2>
                        <span class="tc-caption text-muted">@Model.Components.Count componente(s) vinculado(s) a este sistema</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="tc-btn tc-btn-primary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#addComponentModal">
                            <i class="bi bi-plus-lg me-1"></i>Novo Componente
                        </button>
                        <a class="tc-btn tc-btn-secondary tc-btn-sm" asp-page="/Catalog/Components/Index"><i class="bi bi-box-arrow-up-right me-1"></i>Gerenciar</a>
                    </div>
                </div>
                <div class="tc-card-body p-0">
                    @if (Model.Components.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            Nenhum componente vinculado a este sistema.
                            <button type="button" class="tc-btn tc-btn-primary tc-btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#addComponentModal"><i class="bi bi-plus-lg me-1"></i>Adicionar Componente</button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="tc-table">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Código</th>
                                        <th>Tipo</th>
                                        <th>Departamento</th>
                                        <th>Status</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Components)
                                    {
                                        var componentDept = Model.DepartmentsList.FirstOrDefault(d => d.Id == c.OwnerDepartmentId);
                                        <tr>
                                            <td class="fw-semibold text-dark">@c.Name</td>
                                            <td class="font-monospace text-muted">@(c.Code ?? "-")</td>
                                            <td>@c.ComponentType</td>
                                            <td>@(componentDept?.Name ?? "-")</td>
                                            <td>
                                                @if (c.Status == "Active")
                                                {
                                                    <span class="tc-badge tc-badge-open">Ativo</span>
                                                }
                                                else
                                                {
                                                    <span class="tc-badge tc-badge-closed">Inativo</span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#editComponentModal-@c.Id">
                                                    <i class="bi bi-pencil me-1"></i>Editar
                                                </button>
                                                @if (c.Status == "Active")
                                                {
                                                    <form method="post" asp-page-handler="DeactivateComponent" asp-route-id="@Model.Product?.Id" class="d-inline"
                                                          onsubmit="return confirm('Inativar este componente?');">
                                                        <input type="hidden" name="componentId" value="@c.Id" />
                                                        <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm"><i class="bi bi-slash-circle me-1"></i>Inativar</button>
                                                    </form>
                                                }
                                                <form method="post" asp-page-handler="UnlinkComponent" asp-route-id="@Model.Product?.Id" class="d-inline"
                                                      onsubmit="return confirm('Desvincular este componente deste sistema?');">
                                                    <input type="hidden" name="componentId" value="@c.Id" />
                                                    <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm"><i class="bi bi-unlink me-1"></i>Desvincular</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- MODAL: Adicionar Componente -->
            <div class="modal fade" id="addComponentModal" tabindex="-1" aria-labelledby="addComponentModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content tc-modal-content">
                        <form method="post" asp-page-handler="AddComponent" asp-route-id="@Model.Product?.Id">
                            <div class="modal-header">
                                <h5 class="modal-title" id="addComponentModalLabel">
                                    <i class="bi bi-cpu me-2 text-primary"></i>Adicionar Componente
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="newCompName">Nome do Componente <span class="text-danger">*</span></label>
                                    <input type="text" id="newCompName" class="tc-input" asp-for="NewComponent.Name" placeholder="Ex.: API de Cadastro" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="newCompCode">Código / Sigla</label>
                                    <input type="text" id="newCompCode" class="tc-input" asp-for="NewComponent.Code" placeholder="Ex.: CMP-API-01" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="newCompType">Tipo <span class="text-danger">*</span></label>
                                    <select id="newCompType" class="tc-select" asp-for="NewComponent.ComponentType" required>
                                        <option value="">Selecione...</option>
                                        @foreach (var t in Model.ComponentTypesList.Where(t => t.IsActive))
                                        {
                                            <option value="@t.Code">@t.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="newCompDept">Departamento Responsável</label>
                                    <select id="newCompDept" class="tc-select" asp-for="NewComponent.OwnerDepartmentId">
                                        <option value="">Sem departamento</option>
                                        @foreach (var d in Model.DepartmentsList)
                                        {
                                            <option value="@d.Id">@d.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold" for="newCompDesc">Descrição</label>
                                    <textarea id="newCompDesc" class="tc-textarea" asp-for="NewComponent.Description" rows="2" placeholder="Responsabilidade técnica do componente..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-plus-lg me-1"></i>Adicionar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- MODAL: Editar Componente (um por linha) -->
            @foreach (var c in Model.Components)
            {
                var typeInCatalog = Model.ComponentTypesList.Any(t => t.IsActive && string.Equals(t.Code, c.ComponentType, StringComparison.OrdinalIgnoreCase));
                var rowDept = Model.DepartmentsList.FirstOrDefault(d => d.Id == c.OwnerDepartmentId);
                <div class="modal fade" id="editComponentModal-@c.Id" tabindex="-1" aria-labelledby="editComponentModalLabel-@c.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content tc-modal-content">
                            <form method="post" asp-page-handler="EditComponent" asp-route-id="@Model.Product?.Id">
                                <input type="hidden" name="componentId" value="@c.Id" />
                                <input type="hidden" name="EditComponent.Id" value="@c.Id" />
                                <div class="modal-header">
                                    <h5 class="modal-title" id="editComponentModalLabel-@c.Id">
                                        <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Componente
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="editCompName-@c.Id">Nome do Componente <span class="text-danger">*</span></label>
                                        <input type="text" id="editCompName-@c.Id" class="tc-input" name="EditComponent.Name" value="@c.Name" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="editCompCode-@c.Id">Código / Sigla</label>
                                        <input type="text" id="editCompCode-@c.Id" class="tc-input" name="EditComponent.Code" value="@c.Code" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="editCompType-@c.Id">Tipo <span class="text-danger">*</span></label>
                                        <select id="editCompType-@c.Id" class="tc-select" name="EditComponent.ComponentType" required>
                                            <option value="">Selecione...</option>
                                            @foreach (var t in Model.ComponentTypesList.Where(t => t.IsActive))
                                            {
                                                <option value="@t.Code" selected="@(string.Equals(c.ComponentType, t.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@t.Name</option>
                                            }
                                            @if (!typeInCatalog)
                                            {
                                                <option value="@c.ComponentType" selected>@c.ComponentType (legado)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="editCompDept-@c.Id">Departamento Responsável</label>
                                        <select id="editCompDept-@c.Id" class="tc-select" name="EditComponent.OwnerDepartmentId">
                                            <option value="" selected="@(c.OwnerDepartmentId == null ? "selected" : null)">Sem departamento</option>
                                            @foreach (var d in Model.DepartmentsList)
                                            {
                                                <option value="@d.Id" selected="@(d.Id == c.OwnerDepartmentId ? "selected" : null)">@d.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="editCompStatus-@c.Id">Status</label>
                                        <select id="editCompStatus-@c.Id" class="tc-select" name="EditComponent.Status">
                                            <option value="Active" selected="@(c.Status == "Active" ? "selected" : null)">Ativo</option>
                                            <option value="Inactive" selected="@(c.Status == "Inactive" ? "selected" : null)">Inativo</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold" for="editCompDesc-@c.Id">Descrição</label>
                                        <textarea id="editCompDesc-@c.Id" class="tc-textarea" name="EditComponent.Description" rows="2">@c.Description</textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-save me-1"></i>Salvar Alterações</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- DEPENDÊNCIAS -->
        <div class="tab-pane fade @(activeTab == "dependencies" ? "show active" : "")" id="tab-dependencies" role="tabpanel">
            <div class="tc-card">
                <div class="tc-card-header"><h2 class="tc-card-title mb-0">Dependências entre Componentes</h2></div>
                <div class="tc-card-body p-0">
                    @if ((ctx?.Dependencies.Count ?? 0) == 0)
                    {
                        <div class="p-4 text-center text-muted">Nenhuma dependência registrada para os componentes deste sistema.</div>
                    }
                    else
                    {
                        <table class="tc-table">
                            <thead><tr><th>Origem</th><th></th><th>Destino</th><th>Tipo</th><th>Criticidade</th></tr></thead>
                            <tbody>
                                @foreach (var d in ctx!.Dependencies)
                                {
                                    <tr><td>@d.SourceComponentName</td><td><i class="bi bi-arrow-right"></i></td><td>@d.TargetComponentName</td><td>@d.DependencyType</td><td>@d.Criticality</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- INTEGRAÇÕES -->
        <div class="tab-pane fade @(activeTab == "integrations" ? "show active" : "")" id="tab-integrations" role="tabpanel">
            <div class="tc-card mb-4">
                <div class="tc-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="tc-card-title mb-0">Integrações deste Sistema</h2>
                        <span class="tc-caption text-muted">@Model.Integrations.Count integração(ões) vinculada(s) a este sistema</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="tc-btn tc-btn-primary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#addIntegrationModal">
                            <i class="bi bi-plus-lg me-1"></i>Nova Integração
                        </button>
                        @if (Model.CandidateIntegrations.Count > 0)
                        {
                            <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#linkExistingIntegrationModal">
                                <i class="bi bi-link-45deg me-1"></i>Vincular Existente
                            </button>
                        }
                        <a class="tc-btn tc-btn-secondary tc-btn-sm" asp-page="/Integrations/Index"><i class="bi bi-box-arrow-up-right me-1"></i>Gerenciar</a>
                    </div>
                </div>
                <div class="tc-card-body p-0">
                    @if (Model.Integrations.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            Nenhuma integração vinculada a este sistema.
                            <button type="button" class="tc-btn tc-btn-primary tc-btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#addIntegrationModal"><i class="bi bi-plus-lg me-1"></i>Nova Integração</button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="tc-table">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Nome</th>
                                        <th>Tipo</th>
                                        <th>Característica</th>
                                        <th>Status</th>
                                        <th>Histórico</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.Integrations)
                                    {
                                        <tr>
                                            <td class="font-monospace text-muted">@i.Code</td>
                                            <td class="fw-semibold text-dark">@i.Name</td>
                                            <td>@i.IntegrationType</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(i.Responsibility) || !string.IsNullOrEmpty(i.HostingLocation) || !string.IsNullOrEmpty(i.Direction))
                                                {
                                                    @if (!string.IsNullOrEmpty(i.Responsibility))
                                                    {
                                                        <span class="tc-badge tc-badge-verified" title="Responsabilidade"><i class="bi bi-person-badge me-1"></i>@i.Responsibility</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(i.HostingLocation))
                                                    {
                                                        <span class="tc-badge tc-badge-verified" title="Hospedagem"><i class="bi bi-hdd me-1"></i>@i.HostingLocation</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(i.Direction))
                                                    {
                                                        <span class="tc-badge tc-badge-verified" title="Direção"><i class="bi bi-arrow-left-right me-1"></i>@i.Direction</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted tc-caption">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (i.Status == "Healthy")
                                                {
                                                    <span class="tc-badge tc-badge-open">Saudável</span>
                                                }
                                                else if (i.Status == "Degraded")
                                                {
                                                    <span class="tc-badge tc-badge-medium">Degradada</span>
                                                }
                                                else if (i.Status == "Critical")
                                                {
                                                    <span class="tc-badge tc-badge-critical">Crítica</span>
                                                }
                                                else
                                                {
                                                    <span class="tc-badge tc-badge-closed">@i.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <details>
                                                    <summary class="tc-caption">Ver histórico</summary>
                                                    @if (i.Runs.Count == 0)
                                                    {
                                                        <span class="text-muted tc-caption">Sem execuções registradas.</span>
                                                    }
                                                    else
                                                    {
                                                        <ul class="list-unstyled mb-0 mt-2">
                                                            @foreach (var r in i.Runs.Take(5))
                                                            {
                                                                <li class="d-flex justify-content-between gap-3">
                                                                    <span class="tc-caption text-muted">@r.StartedAt.ToString("dd/MM HH:mm") @(r.TriggeredBy)</span>
                                                                    <span class="tc-caption">
                                                                        @if (r.Status == "Success")
                                                                        {
                                                                            <span class="text-success"><i class="bi bi-check-circle"></i> Sucesso</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-danger"><i class="bi bi-x-circle"></i> @r.Status</span>
                                                                        }
                                                                    </span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </details>
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#editIntegrationModal-@i.Id">
                                                    <i class="bi bi-pencil me-1"></i>Editar
                                                </button>
                                                <form method="post" asp-page-handler="TestIntegrationHealthCheck" asp-route-id="@Model.Product?.Id" class="d-inline">
                                                    <input type="hidden" name="integrationId" value="@i.Id" />
                                                    <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm"><i class="bi bi-activity me-1"></i>Testar</button>
                                                </form>
                                                <form method="post" asp-page-handler="UnlinkIntegration" asp-route-id="@Model.Product?.Id" class="d-inline"
                                                      onsubmit="return confirm('Desvincular esta integração deste sistema? O histórico é preservado.');">
                                                    <input type="hidden" name="integrationId" value="@i.Id" />
                                                    <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm"><i class="bi bi-unlink me-1"></i>Desvincular</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- MODAL: Vincular Integração Existente -->
            <div class="modal fade" id="linkExistingIntegrationModal" tabindex="-1" aria-labelledby="linkExistingIntegrationModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content tc-modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="linkExistingIntegrationModalLabel">
                                <i class="bi bi-link-45deg me-2 text-primary"></i>Vincular Integração Existente
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body p-0">
                            <div class="p-3 border-bottom">
                                <span class="tc-caption text-muted">Vincular uma integração já cadastrada a este sistema preserva todo o histórico de execuções e verificações. Se ela já estiver vinculada a outro sistema, será desvinculada de lá.</span>
                            </div>
                            <div class="table-responsive">
                                <table class="tc-table mb-0">
                                    <thead><tr><th>Código</th><th>Nome</th><th>Tipo</th><th>Vinculada a</th><th class="text-end">Ação</th></tr></thead>
                                    <tbody>
                                        @foreach (var cand in Model.CandidateIntegrations)
                                        {
                                            <tr>
                                                <td class="font-monospace text-muted">@cand.Code</td>
                                                <td>@cand.Name</td>
                                                <td>@cand.IntegrationType</td>
                                                <td>
                                                    @if (cand.ProductId.HasValue)
                                                    {
                                                        <span class="tc-badge tc-badge-medium">Outro sistema (#@cand.ProductId)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted tc-caption">Sem sistema</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#confirmLinkModal-@cand.Id">
                                                        <i class="bi bi-link-45deg me-1"></i>Vincular
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Fechar</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MODAL: Confirmar vínculo (um por candidata, evita o confirm() nativo do navegador) -->
            @foreach (var cand in Model.CandidateIntegrations)
            {
                <div class="modal fade" id="confirmLinkModal-@cand.Id" tabindex="-1" aria-labelledby="confirmLinkModalLabel-@cand.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content tc-modal-content">
                            <form method="post" asp-page-handler="LinkExistingIntegration" asp-route-id="@Model.Product?.Id">
                                <input type="hidden" name="integrationId" value="@cand.Id" />
                                <div class="modal-header">
                                    <h5 class="modal-title" id="confirmLinkModalLabel-@cand.Id">
                                        <i class="bi bi-link-45deg me-2 text-primary"></i>Vincular Integração
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-0">
                                        Vincular <strong>@cand.Name</strong> (<span class="font-monospace">@cand.Code</span>) ao sistema
                                        <strong>@Model.Product?.Name</strong>?
                                    </p>
                                    @if (cand.ProductId.HasValue)
                                    {
                                        <div class="tc-alert tc-alert-warning mt-3 mb-0">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                            Ela será <strong>desvinculada</strong> do sistema #@cand.ProductId. O histórico de execuções e verificações é preservado.
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-link-45deg me-1"></i>Confirmar Vínculo</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <!-- MODAL: Nova Integração (ProductId pré-preenchido) -->
            <div class="modal fade" id="addIntegrationModal" tabindex="-1" aria-labelledby="addIntegrationModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content tc-modal-content">
                        <form method="post" asp-page-handler="AddIntegration" asp-route-id="@Model.Product?.Id">
                            <div class="modal-header">
                                <h5 class="modal-title" id="addIntegrationModalLabel">
                                    <i class="bi bi-arrow-left-right me-2 text-primary"></i>Nova Integração
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                                <div class="tc-alert tc-alert-warning mb-3">
                                    <i class="bi bi-link-45deg me-2"></i>Esta integração será criada já vinculada ao sistema '@Model.Product?.Name'.
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="newIntCode">Código <span class="text-danger">*</span></label>
                                        <input type="text" id="newIntCode" class="tc-input" asp-for="NewIntegration.Code" placeholder="Ex.: INT-ERP-01" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold" for="newIntName">Nome <span class="text-danger">*</span></label>
                                        <input type="text" id="newIntName" class="tc-input" asp-for="NewIntegration.Name" placeholder="Ex.: Sincronização com o ERP" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="newIntType">Tipo <span class="text-danger">*</span></label>
                                        <select id="newIntType" class="tc-select" asp-for="NewIntegration.IntegrationType" required>
                                            <option value="">Selecione...</option>
                                            @foreach (var t in Model.IntegrationTypesList.Where(t => t.IsActive))
                                            {
                                                <option value="@t.Code">@t.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="newIntResp">Responsabilidade</label>
                                        <select id="newIntResp" class="tc-select" asp-for="NewIntegration.Responsibility">
                                            <option value="">Selecione...</option>
                                            @foreach (var v in Model.ValidResponsibilities)
                                            {
                                                <option value="@v">@v</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="newIntHosting">Hospedagem / Local</label>
                                        <select id="newIntHosting" class="tc-select" asp-for="NewIntegration.HostingLocation">
                                            <option value="">Selecione...</option>
                                            @foreach (var v in Model.ValidHostingLocations)
                                            {
                                                <option value="@v">@v</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold" for="newIntDirection">Direção</label>
                                        <select id="newIntDirection" class="tc-select" asp-for="NewIntegration.Direction">
                                            <option value="">Selecione...</option>
                                            @foreach (var v in Model.ValidDirections)
                                            {
                                                <option value="@v">@v</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="newIntDesc">Sistema Alvo / Descrição</label>
                                        <textarea id="newIntDesc" class="tc-textarea" asp-for="NewIntegration.Description" rows="2" placeholder="Sistema ou serviço com o qual esta integração conversa..."></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold" for="newIntNotes">Notas de Contrato / Comerciais</label>
                                        <textarea id="newIntNotes" class="tc-textarea" asp-for="NewIntegration.ContractNotes" rows="2" placeholder="SLA, janela de manutenção, contato..."></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-check-lg me-1"></i>Criar e Vincular</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- MODAL: Editar Integração (um por linha) -->
            @foreach (var i in Model.Integrations)
            {
                var integrationTypeInCatalog = Model.IntegrationTypesList.Any(t => t.IsActive && string.Equals(t.Code, i.IntegrationType, StringComparison.OrdinalIgnoreCase));
                var rowIntegrationDept = Model.DepartmentsList.FirstOrDefault(d => d.Id == i.OwnerDepartmentId);
                <div class="modal fade" id="editIntegrationModal-@i.Id" tabindex="-1" aria-labelledby="editIntegrationModalLabel-@i.Id" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content tc-modal-content">
                            <form method="post" asp-page-handler="EditIntegration" asp-route-id="@Model.Product?.Id">
                                <input type="hidden" name="integrationId" value="@i.Id" />
                                <input type="hidden" name="EditIntegration.Id" value="@i.Id" />
                                <div class="modal-header">
                                    <h5 class="modal-title" id="editIntegrationModalLabel-@i.Id">
                                        <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Integração
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold" for="editIntCode-@i.Id">Código <span class="text-danger">*</span></label>
                                            <input type="text" id="editIntCode-@i.Id" class="tc-input" name="EditIntegration.Code" value="@i.Code" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold" for="editIntName-@i.Id">Nome <span class="text-danger">*</span></label>
                                            <input type="text" id="editIntName-@i.Id" class="tc-input" name="EditIntegration.Name" value="@i.Name" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold" for="editIntType-@i.Id">Tipo <span class="text-danger">*</span></label>
                                            <select id="editIntType-@i.Id" class="tc-select" name="EditIntegration.IntegrationType" required>
                                                <option value="">Selecione...</option>
                                                @foreach (var t in Model.IntegrationTypesList.Where(t => t.IsActive))
                                                {
                                                    <option value="@t.Code" selected="@(string.Equals(i.IntegrationType, t.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@t.Name</option>
                                                }
                                                @if (!integrationTypeInCatalog)
                                                {
                                                    <option value="@i.IntegrationType" selected>@i.IntegrationType (legado)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold" for="editIntResp-@i.Id">Responsabilidade</label>
                                            <select id="editIntResp-@i.Id" class="tc-select" name="EditIntegration.Responsibility">
                                                <option value="" selected="@(string.IsNullOrEmpty(i.Responsibility) ? "selected" : null)">Selecione...</option>
                                                @foreach (var v in Model.ValidResponsibilities)
                                                {
                                                    <option value="@v" selected="@(string.Equals(i.Responsibility, v, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@v</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold" for="editIntHosting-@i.Id">Hospedagem / Local</label>
                                            <select id="editIntHosting-@i.Id" class="tc-select" name="EditIntegration.HostingLocation">
                                                <option value="" selected="@(string.IsNullOrEmpty(i.HostingLocation) ? "selected" : null)">Selecione...</option>
                                                @foreach (var v in Model.ValidHostingLocations)
                                                {
                                                    <option value="@v" selected="@(string.Equals(i.HostingLocation, v, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@v</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold" for="editIntDirection-@i.Id">Direção</label>
                                            <select id="editIntDirection-@i.Id" class="tc-select" name="EditIntegration.Direction">
                                                <option value="" selected="@(string.IsNullOrEmpty(i.Direction) ? "selected" : null)">Selecione...</option>
                                                @foreach (var v in Model.ValidDirections)
                                                {
                                                    <option value="@v" selected="@(string.Equals(i.Direction, v, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@v</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold" for="editIntDept-@i.Id">Departamento Responsável</label>
                                            <select id="editIntDept-@i.Id" class="tc-select" name="EditIntegration.OwnerDepartmentId">
                                                <option value="" selected="@(i.OwnerDepartmentId == null ? "selected" : null)">Sem departamento</option>
                                                @foreach (var d in Model.DepartmentsList)
                                                {
                                                    <option value="@d.Id" selected="@(d.Id == i.OwnerDepartmentId ? "selected" : null)">@d.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold" for="editIntDesc-@i.Id">Sistema Alvo / Descrição</label>
                                            <textarea id="editIntDesc-@i.Id" class="tc-textarea" name="EditIntegration.Description" rows="2">@i.TargetSystemDescription</textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold" for="editIntNotes-@i.Id">Notas de Contrato / Comerciais</label>
                                            <textarea id="editIntNotes-@i.Id" class="tc-textarea" name="EditIntegration.ContractNotes" rows="2">@i.ContractNotes</textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-save me-1"></i>Salvar Alterações</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- FONTES -->
        <div class="tab-pane fade @(activeTab == "sources" || activeTab == "research" ? "show active" : "")" id="tab-sources" role="tabpanel">
            <div class="tc-card mb-4">
                <div class="tc-card-header"><h2 class="tc-card-title mb-0">Fontes Técnicas</h2></div>
                <div class="tc-card-body p-0">
                    @if ((ctx?.TechnicalSources.Count ?? 0) == 0)
                    {
                        <div class="p-4 text-center text-muted">Nenhuma fonte técnica ativa cadastrada.</div>
                    }
                    else
                    {
                        <table class="tc-table">
                            <thead><tr><th>Nome</th><th>Tipo</th><th>Domínio</th><th>Confiança</th><th class="text-end">Ações</th></tr></thead>
                            <tbody>
                                @foreach (var s in ctx!.TechnicalSources)
                                {
                                    <tr>
                                        <td>@s.Name</td>
                                        <td>@s.SourceType</td>
                                        <td>@(string.IsNullOrEmpty(s.Url) ? "-" : s.Url)</td>
                                        <td><span class="tc-badge tc-badge-verified">@s.TrustLevel</span></td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DisableSource" asp-route-id="@Model.Product?.Id" class="d-inline">
                                                <input type="hidden" name="sourceId" value="@s.Id" />
                                                <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm"><i class="bi bi-slash-circle me-1"></i>Desativar</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="tc-card-body border-top">
                    <form method="post" asp-page-handler="AddSource" asp-route-id="@Model.Product?.Id">
                        <div class="row">
                            <div class="col-md-3 mb-2"><input class="tc-input" asp-for="NewSource.Name" placeholder="Nome da fonte" required /></div>
                            <div class="col-md-3 mb-2">
                                <select class="tc-select" asp-for="NewSource.SourceType">
                                    <option value="OfficialDocumentation">Documentação Oficial</option>
                                    <option value="InternalDocumentation">Documentação Interna</option>
                                    <option value="Wiki">Wiki</option>
                                    <option value="Runbook">Runbook</option>
                                    <option value="Swagger">Swagger</option>
                                    <option value="Repository">Repositório</option>
                                    <option value="VendorKnowledgeBase">KB do Fornecedor</option>
                                    <option value="StatusPage">Status Page</option>
                                    <option value="Other">Outro</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-2">
                                <select class="tc-select" asp-for="NewSource.TrustLevel">
                                    <option value="Official">Official</option>
                                    <option value="Internal">Internal</option>
                                    <option value="Trusted">Trusted</option>
                                    <option value="Reference">Reference</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-2"><input class="tc-input" asp-for="NewSource.Url" placeholder="https://..." /></div>
                        </div>
                        <button type="submit" class="tc-btn tc-btn-primary"><i class="bi bi-plus-lg me-1"></i>Adicionar Fonte</button>
                    </form>
                </div>
            </div>

            <div class="tc-card">
                <div class="tc-card-header"><h2 class="tc-card-title mb-0">Pesquisa Externa</h2></div>
                <div class="tc-card-body">
                    <p class="tc-caption text-muted">Define quais fontes externas poderão ser consultadas futuramente pelo Copiloto durante investigações. A política é salva na aba Contexto Técnico (campo "Política de pesquisa externa" faz parte do formulário acima).</p>
                    <p class="mb-2">Política atual: <span class="tc-badge tc-badge-verified">@(ctx?.ExternalResearchPolicy ?? "Disabled")</span></p>

                    @if (string.Equals(ctx?.ExternalResearchPolicy, "AllowListed", StringComparison.OrdinalIgnoreCase))
                    {
                        <h6 class="mt-3">Domínios permitidos</h6>
                        <ul class="list-group mb-3">
                            @foreach (var d in Model.AllowedDomainList)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @d.Domain
                                    <form method="post" asp-page-handler="RemoveDomain" asp-route-id="@Model.Product?.Id" class="d-inline">
                                        <input type="hidden" name="domainId" value="@d.Id" />
                                        <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm"><i class="bi bi-trash"></i></button>
                                    </form>
                                </li>
                            }
                        </ul>
                        <form method="post" asp-page-handler="AddDomain" asp-route-id="@Model.Product?.Id" class="d-flex gap-2">
                            <input class="tc-input" name="domain" placeholder="Ex.: learn.microsoft.com" required />
                            <button type="submit" class="tc-btn tc-btn-secondary text-nowrap"><i class="bi bi-plus-lg me-1"></i>Adicionar domínio</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openConfirmDeployModal(assignmentId, clientName, unitName, productName, currentVersion, newVersion, envsJson) {
            document.getElementById('deployAssignmentId').value = assignmentId;
            document.getElementById('deployClientName').textContent = clientName + (unitName ? ' (' + unitName + ')' : '');
            document.getElementById('deployProductName').textContent = productName;
            document.getElementById('deployCurrentVersion').textContent = currentVersion ? 'v' + currentVersion : 'Não vinculada';
            document.getElementById('deployNewVersion').textContent = 'v' + newVersion;

            var envContainer = document.getElementById('deployEnvContainer');
            var envSelect = document.getElementById('deployEnvironmentId');
            envSelect.innerHTML = '<option value="">Selecione o ambiente...</option>';

            try {
                var envs = JSON.parse(envsJson || '[]');
                if (envs.length > 1) {
                    envs.forEach(function(e) {
                        var opt = document.createElement('option');
                        opt.value = e.id;
                        opt.textContent = e.name;
                        envSelect.appendChild(opt);
                    });
                    envContainer.style.display = 'block';
                    envSelect.required = true;
                } else if (envs.length === 1) {
                    var opt = document.createElement('option');
                    opt.value = envs[0].id;
                    opt.textContent = envs[0].name;
                    opt.selected = true;
                    envSelect.appendChild(opt);
                    envContainer.style.display = 'none';
                    envSelect.required = false;
                } else {
                    envContainer.style.display = 'none';
                    envSelect.required = false;
                }
            } catch(e) {
                envContainer.style.display = 'none';
                envSelect.required = false;
            }

            var modal = new bootstrap.Modal(document.getElementById('modalConfirmDeploy'));
            modal.show();
        }

        function openScheduleModal(assignmentId, clientName, versionLabel) {
            document.getElementById('scheduleAssignmentId').value = assignmentId;
            document.getElementById('scheduleClientName').textContent = clientName;
            document.getElementById('scheduleVersionLabel').textContent = 'v' + versionLabel;
            var now = new Date();
            now.setDate(now.getDate() + 1);
            now.setMinutes(0);
            var offset = now.getTimezoneOffset() * 60000;
            var localISOTime = (new Date(now.getTime() - offset)).toISOString().slice(0, 16);
            document.getElementById('scheduleDatetime').value = localISOTime;
            var modal = new bootstrap.Modal(document.getElementById('modalScheduleAssignment'));
            modal.show();
        }

        function openFailModal(assignmentId, clientName, versionLabel) {
            document.getElementById('failAssignmentId').value = assignmentId;
            document.getElementById('failClientName').textContent = clientName;
            document.getElementById('failVersionLabel').textContent = 'v' + versionLabel;
            document.getElementById('failNotes').value = '';
            var modal = new bootstrap.Modal(document.getElementById('modalFailAssignment'));
            modal.show();
        }

        // ---------- Fase 3: Modal Nova Alteração com busca determinística ----------
        var changeAbortController = null;
        var changeDebounceTimer = null;

        function openAddChangeModal(versionId, versionLabel) {
            document.getElementById('addChangeVersionId').value = versionId;
            document.getElementById('addChangeVersionLabel').textContent = 'v' + versionLabel;
            document.getElementById('addChangeTitle').value = '';
            document.getElementById('addChangeDescription').value = '';
            document.getElementById('addChangeErrorCode').value = '';
            document.getElementById('addChangeComponent').value = '';
            document.getElementById('addChangeType').value = 'Fix';
            document.getElementById('changeCaseSuggestionsContainer').innerHTML = 
                '<div class="tc-empty-state tc-empty-state-compact p-3 border rounded-2 bg-light text-center">' +
                '<div class="tc-empty-icon text-muted mb-1"><i class="bi bi-search fs-4"></i></div>' +
                '<div class="tc-empty-title small fw-semibold text-secondary">Aguardando dados</div>' +
                '<p class="tc-empty-description small text-muted mb-0">Preencha o título para iniciar a busca determinística de casos.</p>' +
                '</div>';
            var modal = new bootstrap.Modal(document.getElementById('modalAddChange'));
            modal.show();
        }

        function scheduleChangeCaseSearch() {
            clearTimeout(changeDebounceTimer);
            changeDebounceTimer = setTimeout(triggerChangeCaseSearch, 450);
        }

        function triggerChangeCaseSearch() {
            var versionId = document.getElementById('addChangeVersionId').value;
            var title = document.getElementById('addChangeTitle').value.trim();
            var description = document.getElementById('addChangeDescription').value.trim();
            var componentId = document.getElementById('addChangeComponent').value;
            var errorCode = document.getElementById('addChangeErrorCode').value.trim();
            var container = document.getElementById('changeCaseSuggestionsContainer');

            if (!versionId || (!title && !description && !errorCode)) {
                return;
            }

            var params = new URLSearchParams();
            params.set('handler', 'PreviewChangeCaseSuggestions');
            params.set('productVersionId', versionId);
            if (title) params.set('title', title);
            if (description) params.set('description', description);
            if (componentId) params.set('componentId', componentId);
            if (errorCode) params.set('errorCode', errorCode);

            if (changeAbortController) changeAbortController.abort();
            changeAbortController = new AbortController();

            container.style.opacity = '0.5';
            fetch(window.location.pathname + '?' + params.toString(), { signal: changeAbortController.signal })
                .then(function(r) { return r.text(); })
                .then(function(html) {
                    container.innerHTML = html;
                    container.style.opacity = '1';
                })
                .catch(function(err) {
                    if (err.name !== 'AbortError') container.style.opacity = '1';
                });
        }

        document.getElementById('addChangeTitle').addEventListener('input', scheduleChangeCaseSearch);
        document.getElementById('addChangeDescription').addEventListener('input', scheduleChangeCaseSearch);
        document.getElementById('addChangeErrorCode').addEventListener('input', scheduleChangeCaseSearch);
        document.getElementById('addChangeComponent').addEventListener('change', scheduleChangeCaseSearch);
        document.getElementById('addChangeType').addEventListener('change', function() {
            if (this.value === 'Fix') {
                scheduleChangeCaseSearch();
            }
        });
    </script>
}
