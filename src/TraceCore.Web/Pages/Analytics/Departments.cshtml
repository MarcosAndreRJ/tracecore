@page
@model TraceCore.Web.Pages.Analytics.DepartmentsModel
@{
    ViewData["Title"] = "Analytics de Departamentos";
}

<div class="tc-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="tc-page-title mb-1"><i class="bi bi-building text-primary me-2"></i>Indicadores por Departamento</h1>
            <p class="tc-page-subtitle text-muted mb-0">Atuação operacional, resolução de incidentes e colaboração transversal entre equipes técnicas.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Analytics/Index" class="tc-btn tc-btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Dashboard Geral
            </a>
            <a asp-page="/Analytics/Users" class="tc-btn tc-btn-secondary">
                <i class="bi bi-people me-1"></i> Usuários
            </a>
        </div>
    </div>
</div>

<!-- Filtros Rápidos -->
<div class="tc-card mb-4">
    <div class="tc-card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3 col-sm-6">
                <label class="tc-form-label mb-1">Período</label>
                <select name="Period" class="tc-select">
                    <option value="7d" selected="@(Model.Filter.Period == "7d")">Últimos 7 dias</option>
                    <option value="30d" selected="@(Model.Filter.Period == "30d" || string.IsNullOrEmpty(Model.Filter.Period))">Últimos 30 dias</option>
                    <option value="90d" selected="@(Model.Filter.Period == "90d")">Últimos 90 dias</option>
                    <option value="6m" selected="@(Model.Filter.Period == "6m")">Últimos 6 meses</option>
                    <option value="12m" selected="@(Model.Filter.Period == "12m")">Últimos 12 meses</option>
                    <option value="all" selected="@(Model.Filter.Period == "all")">Todo o histórico</option>
                </select>
            </div>

            <div class="col-md-3 col-sm-6">
                <label class="tc-form-label mb-1">Produto</label>
                <select name="ProductId" class="tc-select">
                    <option value="">Todos os produtos</option>
                    @foreach (var prod in Model.AvailableProducts)
                    {
                        <option value="@prod.Id" selected="@(Model.Filter.ProductId == prod.Id)">@prod.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-3 col-sm-6">
                <label class="tc-form-label mb-1">Severidade</label>
                <select name="Severity" class="tc-select">
                    <option value="">Todas</option>
                    <option value="Critical" selected="@(Model.Filter.Severity == "Critical")">Crítica</option>
                    <option value="High" selected="@(Model.Filter.Severity == "High")">Alta</option>
                    <option value="Medium" selected="@(Model.Filter.Severity == "Medium")">Média</option>
                    <option value="Low" selected="@(Model.Filter.Severity == "Low")">Baixa</option>
                </select>
            </div>

            <div class="col-md-3 col-sm-6 d-flex gap-2">
                <button type="submit" class="tc-btn tc-btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Aplicar
                </button>
                <a asp-page="/Analytics/Departments" class="tc-btn tc-btn-secondary" title="Limpar">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Alerta Conceitual de Não-Silo e Não-Ranking -->
<div class="alert alert-info d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
    <div>
        <strong>Transversalidade Técnica:</strong> Departamentos representam especialidade e responsabilidade, não silos de conhecimento.
        Os indicadores incluem tanto os casos sob responsabilidade direta quanto componentes dos quais a equipe é proprietária no catálogo e colaborações investigativas.
    </div>
</div>

<!-- Tabela de Departamentos -->
<div class="tc-card mb-4">
    <div class="tc-card-header p-3">
        <h5 class="tc-card-title mb-0 fs-6 fw-bold">
            <i class="bi bi-table me-2"></i>Métricas Operacionais por Departamento
        </h5>
    </div>
    <div class="tc-card-body p-0">
        @if (Model.Analytics.Departments.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-building-slash fs-1 d-block mb-2"></i>
                <p class="mb-0">Nenhum departamento com atividade registrada no filtro atual.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="tc-table mb-0">
                    <thead>
                        <tr>
                            <th>Departamento</th>
                            <th class="text-center">Casos Ativos</th>
                            <th class="text-center">Resolvidos</th>
                            <th class="text-center">MTTR Médio</th>
                            <th class="text-center">MTTR Mediana</th>
                            <th class="text-center">Reaberturas</th>
                            <th class="text-center">Recorrências</th>
                            <th class="text-center">Conhecimentos</th>
                            <th class="text-center">Passos Diagnósticos</th>
                            <th class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dep in Model.Analytics.Departments)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <i class="bi bi-building text-secondary me-2"></i>@dep.DepartmentName
                                </td>
                                <td class="text-center">
                                    @if (dep.ActiveCasesCount > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary fw-bold">@dep.ActiveCasesCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success fw-bold">@dep.ResolvedCasesCount</span>
                                </td>
                                <td class="text-center fw-medium">
                                    @dep.FormattedMttr
                                </td>
                                <td class="text-center text-muted">
                                    @dep.FormattedMttrMedian
                                </td>
                                <td class="text-center">
                                    @if (dep.ReopenedCasesCount > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-dark">@dep.ReopenedCasesCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (dep.RecurrentCasesCount > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">@dep.RecurrentCasesCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@dep.KnowledgeCreatedCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@dep.DiagnosticStepsCount</span>
                                </td>
                                <td class="text-end">
                                    <a href="@dep.DrillDownUrl" class="tc-btn tc-btn-secondary tc-btn-sm" title="Filtrar casos deste departamento">
                                        Casos <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
