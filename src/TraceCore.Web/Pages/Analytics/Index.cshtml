@page
@model TraceCore.Web.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics Operacional & Inteligência Gerencial";
}

<div class="tc-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="tc-page-title mb-1"><i class="bi bi-graph-up text-primary me-2"></i>Analytics & Inteligência Operacional</h1>
            <p class="tc-page-subtitle text-muted mb-0">Métricas consolidadas, MTTR por iteração, causas recorrentes e saúde da operação.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-page="/Copilot" asp-route-question="Qual a tendência de casos e MTTR após as últimas versões publicadas?" class="tc-btn tc-btn-primary" title="Consultar o Copiloto IA sobre tendências e indicadores oficiais">
                <i class="bi bi-stars me-1"></i> Perguntar ao Copiloto
            </a>
            <a asp-page="/Analytics/Departments" class="tc-btn tc-btn-secondary">
                <i class="bi bi-building me-1"></i> Departamentos
            </a>
            <a asp-page="/Analytics/Users" class="tc-btn tc-btn-secondary">
                <i class="bi bi-people me-1"></i> Usuários
            </a>
            <a asp-page="/Analytics/Knowledge" class="tc-btn tc-btn-secondary">
                <i class="bi bi-journal-text me-1"></i> Conhecimento
            </a>
        </div>
    </div>
</div>

<!-- Barra de Filtros Globais Unificados -->
<div class="tc-card mb-4">
    <div class="tc-card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2 col-sm-6">
                <label class="tc-form-label mb-1"><i class="bi bi-calendar3 me-1"></i>Período</label>
                <select name="Period" class="tc-select" onchange="toggleCustomDates(this.value)">
                    <option value="7d" selected="@(Model.Filter.Period == "7d")">Últimos 7 dias</option>
                    <option value="30d" selected="@(Model.Filter.Period == "30d" || string.IsNullOrEmpty(Model.Filter.Period))">Últimos 30 dias</option>
                    <option value="90d" selected="@(Model.Filter.Period == "90d")">Últimos 90 dias</option>
                    <option value="6m" selected="@(Model.Filter.Period == "6m")">Últimos 6 meses</option>
                    <option value="12m" selected="@(Model.Filter.Period == "12m")">Últimos 12 meses</option>
                    <option value="all" selected="@(Model.Filter.Period == "all")">Todo o histórico</option>
                    <option value="custom" selected="@(Model.Filter.Period == "custom")">Personalizado</option>
                </select>
            </div>

            <div class="col-md-2 col-sm-6 custom-date-col @(Model.Filter.Period == "custom" ? "" : "d-none")">
                <label class="tc-form-label mb-1">Data Inicial</label>
                <input type="date" name="StartDate" class="tc-input" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-2 col-sm-6 custom-date-col @(Model.Filter.Period == "custom" ? "" : "d-none")">
                <label class="tc-form-label mb-1">Data Final</label>
                <input type="date" name="EndDate" class="tc-input" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-2 col-sm-6">
                <label class="tc-form-label mb-1"><i class="bi bi-box me-1"></i>Produto</label>
                <select name="ProductId" class="tc-select">
                    <option value="">Todos os produtos</option>
                    @foreach (var prod in Model.AvailableProducts)
                    {
                        <option value="@prod.Id" selected="@(Model.Filter.ProductId == prod.Id)">@prod.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2 col-sm-6">
                <label class="tc-form-label mb-1"><i class="bi bi-building me-1"></i>Departamento</label>
                <select name="DepartmentId" class="tc-select">
                    <option value="">Todos</option>
                    @foreach (var dep in Model.AvailableDepartments)
                    {
                        <option value="@dep.Id" selected="@(Model.Filter.DepartmentId == dep.Id)">@dep.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2 col-sm-6">
                <label class="tc-form-label mb-1"><i class="bi bi-exclamation-diamond me-1"></i>Severidade</label>
                <select name="Severity" class="tc-select">
                    <option value="">Todas</option>
                    <option value="Critical" selected="@(Model.Filter.Severity == "Critical")">Crítica</option>
                    <option value="High" selected="@(Model.Filter.Severity == "High")">Alta</option>
                    <option value="Medium" selected="@(Model.Filter.Severity == "Medium")">Média</option>
                    <option value="Low" selected="@(Model.Filter.Severity == "Low")">Baixa</option>
                </select>
            </div>

            <div class="col-md-2 col-sm-6 d-flex gap-2">
                <button type="submit" class="tc-btn tc-btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-page="/Analytics/Index" class="tc-btn tc-btn-secondary" title="Limpar Filtros">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- KPIs Principais em Cards -->
<div class="row g-3 mb-4">
    <!-- Casos Abertos -->
    <div class="col-xl-3 col-md-6">
        <div class="tc-card h-100 position-relative">
            <div class="tc-card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-semibold">@Model.Overview.OpenCasesMetric.Label</span>
                    <span class="tc-icon-badge bg-primary-subtle text-primary p-2 rounded">
                        <i class="bi bi-folder2-open fs-5"></i>
                    </span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="tc-metric-value mb-0 fw-bold fs-3">@Model.Overview.OpenCasesMetric.FormattedValue</h2>
                    <span class="text-muted small">@Model.Overview.OpenCasesMetric.Unit</span>
                </div>
                <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center small">
                    <span class="text-muted" title="@Model.Overview.OpenCasesMetric.Description">
                        <i class="bi bi-info-circle me-1"></i>Status Open / Reopened
                    </span>
                    <a href="@Model.Overview.OpenCasesMetric.DrillDownUrl" class="text-decoration-none fw-medium">
                        Ver casos <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Casos Resolvidos -->
    <div class="col-xl-3 col-md-6">
        <div class="tc-card h-100 position-relative">
            <div class="tc-card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-semibold">@Model.Overview.ResolvedCasesMetric.Label</span>
                    <span class="tc-icon-badge bg-success-subtle text-success p-2 rounded">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="tc-metric-value mb-0 fw-bold fs-3 text-success">@Model.Overview.ResolvedCasesMetric.FormattedValue</h2>
                    <span class="text-muted small">@Model.Overview.ResolvedCasesMetric.Unit</span>
                </div>
                <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center small">
                    @if (Model.Overview.ResolvedCasesMetric.HasSufficientData && Model.Overview.ResolvedCasesMetric.TrendPercentage.HasValue)
                    {
                        var trend = Model.Overview.ResolvedCasesMetric.TrendPercentage.Value;
                        <span class="@(trend >= 0 ? "text-success" : "text-danger") fw-medium">
                            <i class="bi @(trend >= 0 ? "bi-arrow-up" : "bi-arrow-down")"></i> @trend% vs. período ant.
                        </span>
                    }
                    else
                    {
                        <span class="text-muted"><i class="bi bi-dash"></i> Sem comparativo prévio</span>
                    }
                    <a href="@Model.Overview.ResolvedCasesMetric.DrillDownUrl" class="text-decoration-none fw-medium">
                        Ver casos <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- MTTR por Iteração -->
    <div class="col-xl-3 col-md-6">
        <div class="tc-card h-100 position-relative">
            <div class="tc-card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" title="Média de duração das iterações resolvidas no período (ClosedAt - OpenedAt)">
                        Tempo Médio (MTTR) <i class="bi bi-question-circle ms-1"></i>
                    </span>
                    <span class="tc-icon-badge bg-info-subtle text-info p-2 rounded">
                        <i class="bi bi-stopwatch fs-5"></i>
                    </span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="tc-metric-value mb-0 fw-bold fs-3 text-info">@Model.Overview.MttrMetric.FormattedValue</h2>
                    <span class="text-muted small">por iteração</span>
                </div>
                <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center small">
                    <span class="text-muted">
                        Mediana: <strong>@Model.Overview.MttrMedianMetric.FormattedValue</strong>
                    </span>
                    <a href="@Model.Overview.MttrMetric.DrillDownUrl" class="text-decoration-none fw-medium">
                        Detalhes <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recorrências -->
    <div class="col-xl-3 col-md-6">
        <div class="tc-card h-100 position-relative">
            <div class="tc-card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small text-uppercase fw-semibold" title="Casos com relações Recurrence ou CommonCause">
                        Recorrências <i class="bi bi-question-circle ms-1"></i>
                    </span>
                    <span class="tc-icon-badge bg-warning-subtle text-warning p-2 rounded">
                        <i class="bi bi-arrow-repeat fs-5"></i>
                    </span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="tc-metric-value mb-0 fw-bold fs-3 text-warning">@Model.Overview.RecurrentCasesMetric.FormattedValue</h2>
                    <span class="text-muted small">casos reincidentes</span>
                </div>
                <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center small">
                    <span class="text-muted">Relações Recurrence/Common</span>
                    <a href="@Model.Overview.RecurrentCasesMetric.DrillDownUrl" class="text-decoration-none fw-medium">
                        Ver casos <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Linha de Alertas de Qualidade Operacional -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="tc-card p-3 d-flex flex-row align-items-center justify-content-between border-start border-4 border-secondary">
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Resolvidos Sem Causa Raiz</span>
                <div class="fs-4 fw-bold text-secondary">@Model.Overview.UnconfirmedRootCauseMetric.FormattedValue</div>
                <div class="text-muted small">Resoluções onde a causa não foi confirmada ou categorizada formalmente.</div>
            </div>
            <a href="@Model.Overview.UnconfirmedRootCauseMetric.DrillDownUrl" class="tc-btn tc-btn-secondary tc-btn-sm text-nowrap">
                Revisar Casos <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="tc-card p-3 d-flex flex-row align-items-center justify-content-between border-start border-4 border-primary">
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Resolvidos Sem Conhecimento</span>
                <div class="fs-4 fw-bold text-primary">@Model.Overview.UndocumentedKnowledgeMetric.FormattedValue</div>
                <div class="text-muted small">Casos encerrados sem publicação de lição aprendida ou solução na base.</div>
            </div>
            <a href="@Model.Overview.UndocumentedKnowledgeMetric.DrillDownUrl" class="tc-btn tc-btn-primary tc-btn-sm text-nowrap">
                Documentar <i class="bi bi-journal-plus ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Gráficos e Distribuições -->
<div class="row g-3 mb-4">
    <!-- Evolução Temporal -->
    <div class="col-lg-8">
        <div class="tc-card h-100">
            <div class="tc-card-header d-flex justify-content-between align-items-center p-3">
                <h5 class="tc-card-title mb-0 fs-6 fw-bold">
                    <i class="bi bi-activity text-primary me-2"></i>Evolução Temporal de Abertura e Resolução
                </h5>
                <span class="badge bg-light text-dark">Agrupamento: @Model.Filter.Grouping</span>
            </div>
            <div class="tc-card-body p-3">
                @if (Model.Overview.TimeEvolution.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-bar-chart fs-1 d-block mb-2 text-secondary"></i>
                        <p class="mb-0">Nenhuma movimentação registrada no período selecionado.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="tc-table table-sm">
                            <thead>
                                <tr>
                                    <th>Data / Período</th>
                                    <th>Casos Abertos</th>
                                    <th>Casos Resolvidos</th>
                                    <th style="width: 45%;">Distribuição</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pt in Model.Overview.TimeEvolution)
                                {
                                    int max = Math.Max(1, Math.Max(pt.OpenedCount, pt.ResolvedCount));
                                    double openPct = (double)pt.OpenedCount / max * 100.0;
                                    double resPct = (double)pt.ResolvedCount / max * 100.0;
                                    <tr>
                                        <td class="fw-medium">@pt.Label</td>
                                        <td><span class="badge bg-primary-subtle text-primary">@pt.OpenedCount</span></td>
                                        <td><span class="badge bg-success-subtle text-success">@pt.ResolvedCount</span></td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="progress" style="height: 6px;" title="Abertos: @pt.OpenedCount">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @openPct%"></div>
                                                </div>
                                                <div class="progress" style="height: 6px;" title="Resolvidos: @pt.ResolvedCount">
                                                    <div class="progress-bar bg-success" role="progressbar" style="width: @resPct%"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sistemas e Componentes com Mais Ocorrências -->
    <div class="col-lg-4">
        <div class="tc-card h-100">
            <div class="tc-card-header p-3">
                <h5 class="tc-card-title mb-0 fs-6 fw-bold">
                    <i class="bi bi-pie-chart text-primary me-2"></i>Sistemas Mais Impactados
                </h5>
            </div>
            <div class="tc-card-body p-3">
                @if (Model.Overview.TopProducts.Count == 0)
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-inbox fs-2 d-block mb-1 text-secondary"></i>
                        Sem dados no período.
                    </div>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var prod in Model.Overview.TopProducts)
                        {
                            <li class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <a href="@prod.DrillDownUrl" class="text-decoration-none fw-medium text-dark">
                                        @prod.Name
                                    </a>
                                    <span class="text-muted fw-bold">@prod.Count casos (@prod.Percentage%)</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @prod.Percentage%"></div>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <hr class="my-3" />

                <h6 class="fs-6 fw-bold text-muted mb-2">Componentes Mais Frequentes</h6>
                @if (Model.Overview.TopComponents.Count == 0)
                {
                    <div class="text-muted small">Nenhum componente vinculado.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var comp in Model.Overview.TopComponents)
                        {
                            <a href="@comp.DrillDownUrl" class="badge bg-light text-dark border p-2 text-decoration-none">
                                <strong>@comp.Name</strong> <span class="text-muted">(@comp.Count)</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Seção: Casos que Precisam de Atenção -->
<div class="tc-card mb-4">
    <div class="tc-card-header d-flex justify-content-between align-items-center p-3">
        <div>
            <h5 class="tc-card-title mb-0 fs-6 fw-bold">
                <i class="bi bi-exclamation-triangle text-warning me-2"></i>Casos que Precisam de Atenção
            </h5>
            <small class="text-muted">Ocorrências críticas abertas há dias, reaberturas sucessivas ou reincidências sem diagnóstico formal.</small>
        </div>
        <a asp-page="/Cases/Index" asp-route-Status="Open" class="tc-btn tc-btn-secondary tc-btn-sm">
            Ver Todos os Abertos
        </a>
    </div>
    <div class="tc-card-body p-0">
        @if (Model.Overview.AttentionCases.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                <p class="mb-0 fw-medium">Nenhum caso crítico com anomalia operacional detectada no momento.</p>
                <small class="text-muted">Excelente! A fila de incidentes prioritários está sob controle.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="tc-table mb-0">
                    <thead>
                        <tr>
                            <th>Caso</th>
                            <th>Título / Resumo</th>
                            <th>Severidade</th>
                            <th>Status</th>
                            <th>Idade / Iterações</th>
                            <th>Motivo do Alerta</th>
                            <th class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Overview.AttentionCases)
                        {
                            <tr>
                                <td class="fw-bold text-nowrap">#@item.CaseNumber</td>
                                <td>
                                    <div class="fw-medium text-truncate" style="max-width: 320px;" title="@item.Title">
                                        @item.Title
                                    </div>
                                    <small class="text-muted">Aberto em @item.OpenedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <span class="tc-badge tc-badge-severity-@item.Severity.ToLowerInvariant()">@item.Severity</span>
                                </td>
                                <td>
                                    <span class="tc-badge tc-badge-status-@item.Status.ToLowerInvariant()">@item.Status</span>
                                </td>
                                <td class="small">
                                    <div><strong>@item.ActiveDays dias</strong> ativo</div>
                                    <div class="text-muted">@item.IterationCount iteração(ões)</div>
                                </td>
                                <td>
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle">
                                        <i class="bi bi-info-circle me-1"></i>@item.AttentionReason
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="@item.CaseUrl" class="tc-btn tc-btn-secondary tc-btn-sm">
                                        Investigar <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleCustomDates(value) {
            const cols = document.querySelectorAll('.custom-date-col');
            cols.forEach(c => {
                if (value === 'custom') {
                    c.classList.remove('d-none');
                } else {
                    c.classList.add('d-none');
                }
            });
        }
    </script>
}
