@page "/usuarios"
@model TraceCore.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Gestão de Usuários e Acessos";
    var activeCount = Model.Users.Count(u => u.Status == TraceCore.Domain.Enums.UserStatus.Active);
    var inactiveCount = Model.Users.Count(u => u.Status != TraceCore.Domain.Enums.UserStatus.Active);
}

<div class="tc-container-fluid py-3">
    <!-- BREADCRUMB -->
    <nav class="tc-breadcrumb mb-3" aria-label="Navegação">
        <a asp-page="/Index" class="tc-breadcrumb-item">
            <i class="bi bi-house-door me-1"></i>Início
        </a>
        <span class="tc-breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
        <span class="tc-breadcrumb-item active" aria-current="page">Usuários e Acessos</span>
    </nav>

    <!-- CABEÇALHO DA PÁGINA -->
    <div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h1 class="tc-title-page mb-0">Gestão de Usuários & Acessos</h1>
                <span class="tc-badge tc-badge-primary">Módulo M01</span>
                <span class="tc-badge tc-badge-neutral">RBAC Granular</span>
            </div>
            <p class="tc-subtitle text-muted mb-0">
                Identidade corporativa, perfis com permissões no servidor e governança de acessos (Fase 1).
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="tc-btn tc-btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-person-plus"></i>
                <span>Novo Usuário</span>
            </button>
        </div>
    </div>

    <!-- CARDS DE MÉTRICAS -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            @await Html.PartialAsync("Partials/_MetricCard", (
                "Total de Usuários",
                Model.Users.Count.ToString(),
                "Identidades registradas",
                "bi-people",
                "/usuarios",
                true,
                false,
                (decimal?)null,
                "Neutral"
            ))
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            @await Html.PartialAsync("Partials/_MetricCard", (
                "Usuários Ativos",
                activeCount.ToString(),
                "Com acesso liberado",
                "bi-person-check",
                "/usuarios",
                true,
                false,
                (decimal?)null,
                "Neutral"
            ))
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            @await Html.PartialAsync("Partials/_MetricCard", (
                "Inativos / Revogados",
                inactiveCount.ToString(),
                "Sessões encerradas (BR-005)",
                "bi-person-x",
                "/usuarios",
                true,
                false,
                (decimal?)null,
                "Neutral"
            ))
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            @await Html.PartialAsync("Partials/_MetricCard", (
                "Departamentos Mapeados",
                Model.AvailableDepartments.Count.ToString(),
                "Unidades organizacionais (BR-002)",
                "bi-diagram-3",
                "/departamentos",
                true,
                false,
                (decimal?)null,
                "Neutral"
            ))
        </div>
    </div>

    <!-- MENSAGENS DE FEEDBACK -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="tc-alert tc-alert-success mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <span>@Model.SuccessMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="tc-alert tc-alert-danger mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <span>@Model.ErrorMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <!-- TABELA DE USUÁRIOS -->
    <div class="tc-card p-0">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary"></i>
                <h3 class="tc-card-title mb-0 fs-6">Diretório Corporativo de Identidades</h3>
            </div>
            <span class="tc-caption text-muted">@Model.Users.Count registro(s)</span>
        </div>

        @if (Model.Users.Count == 0)
        {
            <div class="p-4">
                @await Html.PartialAsync("Partials/_EmptyState", (
                    Title: "Nenhum usuário cadastrado",
                    Description: "Cadastre o primeiro operador ou analista técnico no sistema.",
                    Icon: "bi-person-plus",
                    ActionText: "Cadastrar Novo Usuário",
                    ActionUrl: "#createUserModal"
                ))
            </div>
        }
        else
        {
            <div class="tc-table-responsive">
                <table class="tc-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Identidade</th>
                            <th>Status Operacional</th>
                            <th>Departamentos (BR-002)</th>
                            <th>Papéis & Perfis</th>
                            <th>Último Acesso</th>
                            <th class="text-end pe-4">Ações de Governança</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var deptNames = Model.AvailableDepartments
                                .Where(d => user.DepartmentIds.Contains(d.Id))
                                .Select(d => d.Name)
                                .ToList();

                            var roleNames = Model.AvailableRoles
                                .Where(r => user.RoleIds.Contains(r.Id))
                                .Select(r => r.Name)
                                .ToList();

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@user.Name</div>
                                    <div class="tc-caption text-muted font-monospace">@user.Email</div>
                                </td>
                                <td>
                                    @if (user.Status == TraceCore.Domain.Enums.UserStatus.Active)
                                    {
                                        <span class="tc-badge tc-badge-success">
                                            <i class="bi bi-check-circle me-1"></i>Ativo
                                        </span>
                                    }
                                    else if (user.Status == TraceCore.Domain.Enums.UserStatus.Inactive)
                                    {
                                        <span class="tc-badge tc-badge-secondary">
                                            <i class="bi bi-pause-circle me-1"></i>Inativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tc-badge tc-badge-warning">
                                            <i class="bi bi-exclamation-circle me-1"></i>Suspenso
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (deptNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var d in deptNames)
                                            {
                                                <span class="badge bg-light text-dark border">@d</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Nenhum vínculo</span>
                                    }
                                </td>
                                <td>
                                    @if (roleNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var r in roleNames)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@r</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Sem papel atribuído</span>
                                    }
                                </td>
                                <td class="small text-muted font-monospace">
                                    @(user.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca acessou")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <button class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#editDeptsModal-@user.Id" title="Gerenciar Departamentos (BR-002)">
                                            <i class="bi bi-diagram-2"></i>
                                            <span>Depts</span>
                                        </button>
                                        <button class="tc-btn tc-btn-secondary tc-btn-sm" data-bs-toggle="modal" data-bs-target="#editRolesModal-@user.Id" title="Gerenciar Papéis e Permissões">
                                            <i class="bi bi-shield-lock"></i>
                                            <span>Papéis</span>
                                        </button>
                                        <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.Status == TraceCore.Domain.Enums.UserStatus.Active)
                                            {
                                                <input type="hidden" name="newStatus" value="Inactive" />
                                                <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm text-danger" title="Desativar com revogação imediata (BR-005)">
                                                    <i class="bi bi-person-x"></i>
                                                    <span>Desativar</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <input type="hidden" name="newStatus" value="Active" />
                                                <button type="submit" class="tc-btn tc-btn-secondary tc-btn-sm text-success" title="Reativar acesso">
                                                    <i class="bi bi-person-check"></i>
                                                    <span>Ativar</span>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- MODAL: DEPARTAMENTOS DO USUÁRIO -->
                            <div class="modal fade" id="editDeptsModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content tc-modal-content">
                                        <form method="post" asp-page-handler="UpdateDepartments">
                                            <div class="modal-header">
                                                <div>
                                                    <h5 class="modal-title tc-modal-title">
                                                        <i class="bi bi-diagram-3 me-2 text-primary"></i>Departamentos de @user.Name
                                                    </h5>
                                                    <p class="tc-caption text-muted mb-0">Vínculos organizacionais múltiplos (Regra BR-002: N:N)</p>
                                                </div>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var dept in Model.AvailableDepartments)
                                                    {
                                                        <div class="p-2 border rounded bg-white">
                                                            <div class="tc-check-group">
                                                                <input class="tc-check-input" type="checkbox" name="departmentIds" value="@dept.Id"
                                                                       id="dept-@(user.Id)-@dept.Id" @(user.DepartmentIds.Contains(dept.Id) ? "checked" : "") />
                                                                <label class="tc-check-label flex-grow-1" for="dept-@(user.Id)-@dept.Id">
                                                                    <strong class="text-dark">@dept.Name</strong>
                                                                    <div class="text-muted tc-caption">@dept.Description</div>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="tc-btn tc-btn-primary">
                                                    <i class="bi bi-check2 me-1"></i>
                                                    <span>Salvar Vínculos</span>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- MODAL: PAPÉIS E PERMISSÕES DO USUÁRIO -->
                            <div class="modal fade" id="editRolesModal-@user.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                    <div class="modal-content tc-modal-content">
                                        <form method="post" asp-page-handler="UpdateRoles">
                                            <div class="modal-header">
                                                <div>
                                                    <h5 class="modal-title tc-modal-title">
                                                        <i class="bi bi-shield-lock me-2 text-primary"></i>Papéis & Perfis de @user.Name
                                                    </h5>
                                                    <p class="tc-caption text-muted mb-0">Autorização granular validada no servidor (BR-003 / DEV-AI-005)</p>
                                                </div>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <div class="d-flex flex-column gap-3">
                                                    @foreach (var role in Model.AvailableRoles)
                                                    {
                                                        <div class="p-3 border rounded bg-white">
                                                            <div class="tc-check-group mb-2">
                                                                <input class="tc-check-input" type="checkbox" name="roleIds" value="@role.Id"
                                                                       id="role-@(user.Id)-@role.Id" @(user.RoleIds.Contains(role.Id) ? "checked" : "") />
                                                                <label class="tc-check-label flex-grow-1" for="role-@(user.Id)-@role.Id">
                                                                    <strong class="text-dark">@role.Name</strong>
                                                                    <span class="text-muted small ms-2">— @role.Description</span>
                                                                </label>
                                                            </div>
                                                            <div class="ms-4 d-flex flex-wrap gap-1">
                                                                @foreach (var p in role.Permissions)
                                                                {
                                                                    <span class="tc-code-inline" style="font-size: 0.72rem;">@p.Code</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="tc-btn tc-btn-primary">
                                                    <i class="bi bi-check2 me-1"></i>
                                                    <span>Salvar Papéis</span>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL: CRIAR NOVO USUÁRIO -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content tc-modal-content">
            <form method="post" asp-page-handler="CreateUser">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title tc-modal-title" id="createUserModalLabel">
                            <i class="bi bi-person-plus me-2 text-primary"></i>Cadastrar Novo Usuário Corporativo
                        </h5>
                        <p class="tc-caption text-muted mb-0">Atribuição de identidade e regras organizacionais (BR-001)</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="tc-alert tc-alert-info mb-3 small">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Regra BR-001:</strong> Todo usuário ativo deve possuir identidade única, nome completo, e-mail/login corporativo e ao menos um vínculo organizacional ou papel atribuído.
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="tc-form-label">Nome Completo *</label>
                            <input type="text" name="name" class="tc-input" required placeholder="Ex.: Maria Souza" />
                        </div>
                        <div class="col-md-6">
                            <label class="tc-form-label">E-mail Corporativo *</label>
                            <input type="email" name="email" class="tc-input" required placeholder="maria.souza@empresa.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="tc-form-label">Senha Inicial *</label>
                            <input type="password" name="password" class="tc-input" required minlength="6" placeholder="Mínimo 6 caracteres" />
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="tc-form-label">Vínculo Organizacional (Departamentos)</label>
                            <div class="border rounded p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var dept in Model.AvailableDepartments)
                                {
                                    <div class="tc-check-group mb-1">
                                        <input class="tc-check-input" type="checkbox" name="departmentIds" value="@dept.Id" id="create-dept-@dept.Id" />
                                        <label class="tc-check-label" for="create-dept-@dept.Id">
                                            <strong class="text-dark">@dept.Name</strong>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="tc-form-label">Papéis Iniciais</label>
                            <div class="border rounded p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <div class="tc-check-group mb-1">
                                        <input class="tc-check-input" type="checkbox" name="roleIds" value="@role.Id" id="create-role-@role.Id" />
                                        <label class="tc-check-label" for="create-role-@role.Id">
                                            <strong class="text-dark">@role.Name</strong>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="tc-btn tc-btn-primary">
                        <i class="bi bi-check2 me-1"></i>
                        <span>Cadastrar Usuário</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
