@page
@model TraceCore.Web.Pages.Integrations.IndexModel
@using TraceCore.Application.DTOs
@{
    ViewData["Title"] = "Integrações - TraceCore";
}

<div class="tc-breadcrumb">
    <span class="tc-breadcrumb-item"><a asp-page="/Index">Início</a></span>
    <span class="tc-breadcrumb-item active">Integrações</span>
</div>

<div class="tc-page-header">
    <div>
        <h1 class="tc-page-header-title">
            <i class="bi bi-plug text-primary" aria-hidden="true"></i>
            <span>Catálogo de Integrações</span>
        </h1>
        <p class="tc-page-header-subtitle">Registro administrativo de integrações entre sistemas e histórico de execuções manuais (Módulo M10)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="tc-btn tc-btn-secondary" data-bs-toggle="modal" data-bs-target="#runIntegrationModal">
            <i class="bi bi-clock-history me-1"></i>
            <span>Registrar Execução</span>
        </button>
        <button type="button" class="tc-btn tc-btn-secondary" data-bs-toggle="modal" data-bs-target="#statusIntegrationModal">
            <i class="bi bi-arrow-repeat me-1"></i>
            <span>Alterar Status</span>
        </button>
        <button type="button" class="tc-btn tc-btn-primary" data-bs-toggle="modal" data-bs-target="#newIntegrationModal">
            <i class="bi bi-plus-lg me-1"></i>
            <span>Nova Integração</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="tc-alert tc-alert-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="tc-alert tc-alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="tc-alert tc-alert-info mb-4" role="alert">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>Catálogo, não conexão.</strong>
    Este módulo registra integrações e seu histórico operacional.
    Não há conectores ativos: status e execuções são gerenciados manualmente
    (decisões de arquitetura ADR-P005 e ADR-P010 permanecem em aberto).
</div>

<div class="row g-4 mb-4">
    <div class="col">
        <div class="tc-stat-card">
            <div class="tc-stat-label">Total de Integrações</div>
            <div class="tc-stat-value">@Model.IntegrationsList.Count</div>
        </div>
    </div>
    <div class="col">
        <div class="tc-stat-card">
            <div class="tc-stat-label">Ativas</div>
            <div class="tc-stat-value text-success">@Model.IntegrationsList.Count(i => i.Status == "Active")</div>
        </div>
    </div>
    <div class="col">
        <div class="tc-stat-card">
            <div class="tc-stat-label">Configuradas (aguardando ativação)</div>
            <div class="tc-stat-value text-info">@Model.IntegrationsList.Count(i => i.Status == "Configured")</div>
        </div>
    </div>
    <div class="col">
        <div class="tc-stat-card">
            <div class="tc-stat-label">Inativas / Erro</div>
            <div class="tc-stat-value text-danger">@Model.IntegrationsList.Count(i => i.Status == "Inactive" || i.Status == "Error")</div>
        </div>
    </div>
    <div class="col">
        <div class="tc-stat-card">
            <div class="tc-stat-label">Execuções Registradas</div>
            <div class="tc-stat-value">@Model.IntegrationsList.Sum(i => i.Runs.Count)</div>
        </div>
    </div>
</div>

@if (Model.IntegrationsList.Count == 0)
{
    <div class="tc-card">
        <div class="tc-card-body">
            <div class="p-4 text-center text-muted">
                <i class="bi bi-plug display-6 d-block mb-2 text-secondary opacity-50"></i>
                <div class="fw-semibold">Nenhuma integração cadastrada</div>
                <p class="tc-caption text-secondary mb-2">Cadastre integrações entre sistemas para manter o histórico técnico do ecossistema.</p>
                <button type="button" class="tc-btn tc-btn-primary" data-bs-toggle="modal" data-bs-target="#newIntegrationModal">
                    <i class="bi bi-plus-lg me-1"></i>Cadastrar Primeira Integração
                </button>
            </div>
        </div>
    </div>
}
else
{
    foreach (var integration in Model.IntegrationsList)
    {
        var lastRun = integration.Runs.FirstOrDefault();
        var statusClass = integration.Status switch
        {
            "Active" => "tc-badge-verified",
            "Inactive" => "tc-badge-closed",
            "Error" => "tc-badge-danger",
            _ => "tc-badge-progress"
        };
        var statusLabel = integration.Status switch
        {
            "Active" => "Ativa",
            "Inactive" => "Inativa",
            "Error" => "Erro",
            _ => "Configurada"
        };

        <div class="tc-card mb-3">
            <details class="tc-card-body" @(lastRun != null ? "" : "open")>
                <summary class="d-flex flex-wrap align-items-center gap-2 list-unstyled" style="cursor:pointer;">
                    <div class="me-auto">
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-box-arrow-in-right text-secondary me-2"></i>@integration.Name
                        </div>
                        <span class="tc-caption text-muted">
                            Código: <span class="font-monospace">@integration.Code</span>
                        </span>
                    </div>
                    <span class="tc-badge tc-badge-sm tc-badge-progress">
                        <i class="bi bi-diagram-3" aria-hidden="true"></i>
                        <span>@integration.IntegrationType</span>
                    </span>
                    <span class="tc-badge tc-badge-sm @statusClass">
                        <i class="bi bi-circle-fill" aria-hidden="true"></i>
                        <span>@statusLabel</span>
                    </span>
                    <span class="tc-badge tc-badge-sm tc-badge-open">
                        <i class="bi bi-building" aria-hidden="true"></i>
                        <span>@(string.IsNullOrWhiteSpace(integration.OwnerDepartmentName) ? "Sem departamento" : integration.OwnerDepartmentName)</span>
                    </span>
                    <span class="tc-caption text-muted">
                        Última execução: @(lastRun is null ? "—" : $"{lastRun.RecordedAt:dd/MM/yyyy HH:mm} ({lastRun.Status})")
                    </span>
                </summary>

                <div class="mt-3 pt-3 border-top">
                    <div class="row g-4">
                        <div class="col-lg-5">
                            <div class="mb-2">
                                <span class="tc-caption fw-semibold text-uppercase text-muted">Sistema Alvo</span>
                                <p class="mb-2">@integration.TargetSystemDescription</p>
                                <span class="tc-caption fw-semibold text-uppercase text-muted">Notas de Contrato</span>
                                <p class="mb-0 small text-secondary">@(string.IsNullOrWhiteSpace(integration.ContractNotes) ? "—" : integration.ContractNotes)</p>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="fw-semibold mb-2">
                                <i class="bi bi-clock-history text-secondary me-1"></i>Histórico de Execuções (@integration.Runs.Count)
                            </div>
                            @if (integration.Runs.Count == 0)
                            {
                                <p class="tc-caption text-muted mb-0">Nenhuma execução registrada. Use "Registrar Execução" para registrar um log manual.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="tc-table">
                                        <thead>
                                            <tr>
                                                <th>Data</th>
                                                <th>Status</th>
                                                <th class="text-end">Registros</th>
                                                <th>Erro / Observação</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var run in integration.Runs)
                                            {
                                                var runClass = run.Status switch
                                                {
                                                    "Failed" => "tc-badge-danger",
                                                    "Partial" => "tc-badge-warning",
                                                    _ => "tc-badge-verified"
                                                };
                                                <tr>
                                                    <td class="text-nowrap">@run.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>
                                                        <span class="tc-badge tc-badge-sm @runClass">@run.Status</span>
                                                    </td>
                                                    <td class="text-end">@(run.RecordsProcessed?.ToString("N0") ?? "—")</td>
                                                    <td class="small text-secondary">@(string.IsNullOrWhiteSpace(run.ErrorMessage) ? "—" : run.ErrorMessage)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </details>
        </div>
    }
}

<!-- MODAL: Nova Integração -->
<div class="modal fade" id="newIntegrationModal" tabindex="-1" aria-labelledby="newIntegrationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content tc-modal-content">
            <form method="post" asp-page-handler="CreateIntegration">
                <div class="modal-header">
                    <h5 class="modal-title" id="newIntegrationModalLabel">
                        <i class="bi bi-plug me-2 text-primary"></i>Nova Integração
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="tc-alert tc-alert-info mb-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Integração entra no catálogo com status <strong>Configurada</strong> — nunca como conexão ativa.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="newIntCode">Código <span class="text-danger">*</span></label>
                        <input type="text" id="newIntCode" class="tc-input" asp-for="NewIntegration.Code" placeholder="Ex.: INT-SAP" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="newIntName">Nome <span class="text-danger">*</span></label>
                        <input type="text" id="newIntName" class="tc-input" asp-for="NewIntegration.Name" placeholder="Ex.: Integração SAP" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="newIntType">Tipo de Integração <span class="text-danger">*</span></label>
                        <select id="newIntType" class="tc-select" asp-for="NewIntegration.IntegrationType" required>
                            <option value="Sap">SAP / ERP (Finanças, Mestre)</option>
                            <option value="Ticketing">Sistema de Chamados / Suporte</option>
                            <option value="Monitoring">Monitoração / Observabilidade</option>
                            <option value="Telemetry">Telemetria / Métricas</option>
                            <option value="Directory">Diretório / IAM (AD/LDAP)</option>
                            <option value="Notification">Notificação / E-mail / Push</option>
                            <option value="Repository">Repositório / CI/CD</option>
                            <option value="Other">Outro</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="newIntTarget">Sistema Alvo / Descrição</label>
                        <textarea id="newIntTarget" class="tc-textarea" asp-for="NewIntegration.TargetSystemDescription" rows="2" placeholder="Ex.: ERP SAP — dados mestre e financeiro"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="newIntDept">Departamento Responsável</label>
                        <select id="newIntDept" class="tc-select" asp-for="NewIntegration.OwnerDepartmentId">
                            <option value="">-- Não atribuído --</option>
                            @foreach (var dept in Model.DepartmentsList)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="newIntNotes">Notas de Contrato</label>
                        <textarea id="newIntNotes" class="tc-textarea" asp-for="NewIntegration.ContractNotes" rows="2" placeholder="Ex.: Contrato / Acordo de nível de serviço, isolamento, responsável pelo conector..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="tc-btn tc-btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Cadastrar Integração
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Registrar Execução -->
<div class="modal fade" id="runIntegrationModal" tabindex="-1" aria-labelledby="runIntegrationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content tc-modal-content">
            <form method="post" asp-page-handler="RegisterRun">
                <div class="modal-header">
                    <h5 class="modal-title" id="runIntegrationModalLabel">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Registrar Execução Manual
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="tc-alert tc-alert-info mb-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Registra um log operacional feito por um humano (ex.: execução manual de sincronização). Não dispara nenhum conector.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="runInt">Integração <span class="text-danger">*</span></label>
                        <select id="runInt" class="tc-select" asp-for="RunInput.IntegrationId" required>
                            <option value="">-- Selecione a integração --</option>
                            @foreach (var integration in Model.IntegrationsList)
                            {
                                <option value="@integration.Id">@integration.Name (@integration.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Resultado da Execução <span class="text-danger">*</span></label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="RunInput.Status" value="Success" id="runSuccess" checked />
                            <label class="form-check-label" for="runSuccess">Sucesso</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="RunInput.Status" value="Partial" id="runPartial" />
                            <label class="form-check-label" for="runPartial">Parcial (sincronização incompleta)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="RunInput.Status" value="Failed" id="runFailed" />
                            <label class="form-check-label" for="runFailed">Falhou (execução com erro)</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="runStarted">Data / Hora da Execução</label>
                        <input type="datetime-local" id="runStarted" class="tc-input" asp-for="RunInput.StartedAt" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="runRecords">Registros Processados</label>
                        <input type="number" id="runRecords" class="tc-input" asp-for="RunInput.RecordsProcessed" min="0" placeholder="Ex.: 1250" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="runError">Erro / Observação</label>
                        <textarea id="runError" class="tc-textarea" asp-for="RunInput.ErrorMessage" rows="2" placeholder="Preencher em caso de falha ou observação relevante..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="tc-btn tc-btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Registrar Execução
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Alterar Status -->
<div class="modal fade" id="statusIntegrationModal" tabindex="-1" aria-labelledby="statusIntegrationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content tc-modal-content">
            <form method="post" asp-page-handler="UpdateStatus">
                <div class="modal-header">
                    <h5 class="modal-title" id="statusIntegrationModalLabel">
                        <i class="bi bi-arrow-repeat me-2 text-primary"></i>Alterar Status Manual
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="tc-alert tc-alert-info mb-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        O status muda <strong>somente por ação manual</strong> — não há verificação automática de conexão.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="statusInt">Integração <span class="text-danger">*</span></label>
                        <select id="statusInt" class="tc-select" asp-for="StatusInput.IntegrationId" required>
                            <option value="">-- Selecione a integração --</option>
                            @foreach (var integration in Model.IntegrationsList)
                            {
                                <option value="@integration.Id">@integration.Name (@integration.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Novo Status <span class="text-danger">*</span></label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="StatusInput.Status" value="Configured" id="statusConfigured" checked />
                            <label class="form-check-label" for="statusConfigured">Configurada (catálogo, sem conexão ativa)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="StatusInput.Status" value="Active" id="statusActive" />
                            <label class="form-check-label" for="statusActive">Ativa</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="StatusInput.Status" value="Inactive" id="statusInactive" />
                            <label class="form-check-label" for="statusInactive">Inativa (pausada / descontinuada)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="StatusInput.Status" value="Error" id="statusError" />
                            <label class="form-check-label" for="statusError">Erro (falha permanente conhecida)</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="tc-btn tc-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="tc-btn tc-btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Atualizar Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>