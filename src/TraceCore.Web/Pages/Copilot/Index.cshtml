@page
@model TraceCore.Web.Pages.Copilot.IndexModel
@using TraceCore.Application.DTOs
@{
    ViewData["Title"] = "Copiloto IA - TraceCore";
}

<div class="tc-breadcrumb">
    <span class="tc-breadcrumb-item"><a asp-page="/Index">Início</a></span>
    <span class="tc-breadcrumb-item active">Copiloto IA</span>
</div>

<div class="tc-page-header">
    <div>
        <h1 class="tc-page-header-title">
            <i class="bi bi-stars text-primary" aria-hidden="true"></i>
            <span>Copiloto IA</span>
            <span class="tc-ai-badge ms-2" role="status" title="Respostas formuladas por IA assistida sobre a base oficial (RAG)">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <span>Assistido por IA</span>
            </span>
        </h1>
        <p class="tc-page-header-subtitle">Assistente sobre a base oficial do TraceCore — respostas com fontes citáveis, sem publicação automática (M12)</p>
    </div>
</div>

<div class="tc-alert tc-alert-info mb-4" role="alert">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>Critérios de resposta.</strong>
    O copiloto responde com base apenas no conteúdo recuperado da base oficial
    (artigos validados, casos históricos e documentação). Sem contexto suficiente,
    declara insuficiência <strong>sem inventar procedimentos</strong>. Nada é publicado
    automaticamente como conhecimento (BR-081, BR-083, BR-085).
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="tc-alert tc-alert-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="tc-alert tc-alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
    </div>
}

<div class="row mb-4">
    <div class="col-lg-10 col-12">
        <div class="tc-card">
            <div class="tc-card-body">
                <form method="post" asp-page-handler="Ask" class="d-flex flex-column gap-3">
                    <label asp-for="Question" class="fw-semibold">Sua pergunta técnica</label>
                    <textarea asp-for="Question" class="form-control" rows="4"
                              placeholder="Ex.: Como resetar a senha de acesso em caso de bloqueio?"></textarea>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="tc-btn tc-btn-primary">
                            <i class="bi bi-send me-1"></i>
                            <span>Perguntar</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.LastAnswer != null)
{
    var answer = Model.LastAnswer;

    <div class="tc-card mb-4">
        <div class="tc-card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <h5 class="mb-3">
                    <i class="bi bi-question-circle me-1"></i>
                    @answer.Question
                </h5>
                @await Html.PartialAsync("Partials/_AIContentBadge", (
                    "Formulado por IA",
                    "Resposta gerada pelo provedor de LLM configurado, com base no conteúdo recuperado da base oficial"
                ))
            </div>

            <div class="mb-3">@Html.Raw(SimpleMarkdown(answer.Answer))</div>

            @if (answer.UsedContext && answer.Sources.Count > 0)
            {
                <hr />
                <h6 class="mb-2">
                    <i class="bi bi-link-45deg me-1"></i>
                    Fontes citadas (BR-084)
                </h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var source in answer.Sources)
                    {
                        <a class="text-decoration-none" href="@source.Url" title="Abrir origem: @source.Title">
                            @await Html.PartialAsync("Partials/_SourceReferenceChip", (SourceLabel(source.SourceType), source.Title))
                        </a>
                    }
                </div>
                <div class="mt-3 text-muted small">
                    Provedor: <strong>@answer.ProviderCode</strong>
                    @if (!string.IsNullOrEmpty(answer.ModelName))
                    {
                        <text>• Modelo: <strong>@answer.ModelName</strong></text>
                    }
                    • Latência: <strong>@answer.LatencyMs ms</strong>
                    @if (answer.TokensUsed.HasValue)
                    {
                        <text>• Tokens: <strong>@answer.TokensUsed</strong></text>
                    }
                </div>
            }

            @if (answer.ToolResults != null && answer.ToolResults.Count > 0)
            {
                <hr />
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">
                            <i class="bi bi-cpu me-1 text-primary"></i>
                            Dados Determinísticos do TraceCore (Princípio §31)
                        </h6>
                        <span class="tc-badge tc-badge-sm tc-badge-verified">
                            <i class="bi bi-shield-check me-1"></i>Fonte Primária
                        </span>
                    </div>
                    <p class="tc-caption text-muted mb-2">
                        Estes números foram calculados diretamente pelo motor analítico do TraceCore sobre a base histórica.
                        A síntese da IA é restrita a narrar estes fatos, sem inventar percentuais ou indicadores.
                    </p>
                    @foreach (var tr in answer.ToolResults)
                    {
                        <div class="p-3 bg-light rounded border mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold font-monospace small">@tr.ToolName</span>
                                @if (tr.Success)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Executado com Sucesso</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Falha</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(tr.ResultJson))
                            {
                                <pre class="mb-0 p-2 bg-white rounded border small text-dark font-monospace" style="max-height: 200px; overflow-y: auto;">@tr.ResultJson</pre>
                            }
                            @if (!string.IsNullOrWhiteSpace(tr.ErrorMessage))
                            {
                                <div class="text-danger small mt-1">@tr.ErrorMessage</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (answer.Notice != null)
            {
                <div class="tc-alert tc-alert-warning mt-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>@answer.Notice
                </div>
            }

            @if (answer.InteractionId.HasValue)
            {
                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    <form method="post" asp-page-handler="Feedback" class="d-inline">
                        <input type="hidden" name="FeedbackInteractionId" value="@answer.InteractionId" />
                        <input type="hidden" name="FeedbackUseful" value="true" />
                        <button type="submit" class="tc-btn tc-btn-secondary">
                            <i class="bi bi-hand-thumbs-up me-1"></i>
                            <span>Útil</span>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Feedback" class="d-inline">
                        <input type="hidden" name="FeedbackInteractionId" value="@answer.InteractionId" />
                        <input type="hidden" name="FeedbackUseful" value="false" />
                        <button type="submit" class="tc-btn tc-btn-secondary">
                            <i class="bi bi-hand-thumbs-down me-1"></i>
                            <span>Não útil</span>
                        </button>
                    </form>

                    @if (User.HasClaim("permission", "solucao.criar"))
                    {
                        <form method="post" asp-page-handler="CreateDraft" class="d-inline ms-auto"
                              onsubmit="return confirm('Criar um RASCUNHO de conhecimento a partir desta resposta? Ele nascerá como rascunho (não publicado) e seguirá o fluxo de revisão.');">
                            <input type="hidden" name="DraftInteractionId" value="@answer.InteractionId" />
                            <button type="submit" class="tc-btn tc-btn-primary">
                                <i class="bi bi-journal-plus me-1"></i>
                                <span>Criar rascunho</span>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}

@functions {
    private static string SourceLabel(string sourceType) => sourceType.ToLowerInvariant() switch
    {
        "validatedknowledge" => "Conteúdo validado",
        "historicalcase" => "Caso histórico",
        "document" => "Documentação",
        _ => sourceType
    };

    private static string SimpleMarkdown(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;

        var escaped = System.Net.WebUtility.HtmlEncode(text);

        // Citações [FONTE n]
        escaped = System.Text.RegularExpressions.Regex.Replace(
            escaped, @"\[FONTE\s+(\d+)\]", "<span class=\"tc-code-inline\">[FONTE $1]</span>");

        // Parágrafos e quebras simples
        var paragraphs = escaped
            .Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(p => $"<p class=\"mb-2\">{(p.Contains('\n') ? p.Replace("\n", "<br />") : p)}</p>");

        return string.Join("\n", paragraphs);
    }
}