@model string

@{
    // Valores válidos de Case.Status: Open, Reopened, Investigating, Resolved (ver Case.cs).
    // "Reopened"/"Investigating" caíam incorretamente no rótulo "Fechado" antes desta correção.
    var status = Model ?? "Open";
    var (badgeClass, iconClass, label) = status.ToLowerInvariant() switch
    {
        "resolved" => ("tc-badge-confirmed", "bi-check2-all", "Resolvido"),
        "open" => ("tc-badge-open", "bi-record-circle", "Aberto"),
        "reopened" => ("tc-badge-open", "bi-arrow-counterclockwise", "Reaberto"),
        "investigating" => ("tc-badge-open", "bi-search", "Em Investigação"),
        _ => ("tc-badge-closed", "bi-check-circle", "Fechado")
    };
}

<span class="tc-badge @badgeClass" role="status" title="Status do Caso: @label">
    <i class="bi @iconClass" aria-hidden="true"></i>
    <span>@label</span>
</span>
