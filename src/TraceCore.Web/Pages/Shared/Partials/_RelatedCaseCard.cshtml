@model (string CaseNumber, string Title, string Severity, string Status, int SimilarityScore, string? Summary)

<div class="tc-card p-3 mb-3 border">
    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="tc-code-inline">@Model.CaseNumber</span>
                @await Html.PartialAsync("Partials/_SeverityBadge", Model.Severity)
                @await Html.PartialAsync("Partials/_CaseStatusBadge", Model.Status)
            </div>
            <h6 class="mb-0 fw-semibold text-dark">@Model.Title</h6>
        </div>
        <div class="text-end flex-shrink-0">
            <span class="tc-badge tc-badge-supported" title="Grau de similaridade contextual">
                <i class="bi bi-intersect"></i>
                <span>@Model.SimilarityScore% similar</span>
            </span>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        <p class="text-muted small mb-2 line-clamp-2">@Model.Summary</p>
    }
    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
        <span class="tc-caption text-muted">BR-030: Correlação de Casos</span>
        <a href="/Cases/Index?search=@Model.CaseNumber" class="tc-btn tc-btn-ghost tc-btn-sm text-primary">
            <span>Visualizar Caso</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>
