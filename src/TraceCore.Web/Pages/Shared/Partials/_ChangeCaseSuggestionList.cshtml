@model System.Collections.Generic.IReadOnlyList<TraceCore.Application.DTOs.VersionChangeCaseSuggestionDto>

@if (Model == null || Model.Count == 0)
{
    <div class="tc-empty-state tc-empty-state-compact p-3 border rounded-2 bg-light text-center">
        <div class="tc-empty-icon text-muted mb-1"><i class="bi bi-search fs-4"></i></div>
        <div class="tc-empty-title small fw-semibold text-secondary">Nenhum caso sugerido</div>
        <p class="tc-empty-description small text-muted mb-0">Preencha o título, descrição, componente ou código do erro para buscar casos anteriores potencialmente resolvidos.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var sim in Model)
        {
            <div class="tc-card p-2 px-3 mb-0 border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <input type="checkbox" name="NewChange.SelectedCaseIdsToLink" value="@sim.CaseId" class="form-check-input me-1 link-case-checkbox" id="chk-case-@sim.CaseId" />
                        <label for="chk-case-@sim.CaseId" class="fw-bold text-primary small mb-0 cursor-pointer">
                            #@sim.CaseNumber
                        </label>
                        @await Html.PartialAsync("~/Pages/Shared/Partials/_CaseStatusBadge.cshtml", sim.CaseStatus)
                        @if (!string.IsNullOrEmpty(sim.ProductVersionLabel))
                        {
                            <span class="badge bg-light text-secondary border small" style="font-size: 0.7rem;">@sim.ProductVersionLabel</span>
                        }
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold"
                          title="Score de correspondência determinística (não é probabilidade)">
                        @sim.Score
                    </span>
                </div>
                <div class="small text-dark mb-1 tc-truncate" style="max-width: 100%;" title="@sim.CaseTitle">
                    @sim.CaseTitle
                </div>
                @if (sim.MatchedFactors.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var factor in sim.MatchedFactors)
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size: 0.68rem;">
                                @factor
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <p class="tc-caption text-muted mt-2 mb-0">
        <i class="bi bi-info-circle me-1"></i>Casos marcados serão vinculados automaticamente como <strong>"Corrigido por"</strong> ao salvar a alteração. O status dos casos não será alterado.
    </p>
}
