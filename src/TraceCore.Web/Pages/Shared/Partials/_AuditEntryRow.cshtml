@model (string UserName, string Action, string Details, DateTime Timestamp)

<div class="tc-audit-row">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-shield-check text-muted" aria-hidden="true"></i>
        <span class="tc-audit-user">@Model.UserName</span>
        <span class="tc-audit-action">@Model.Action</span>
        @if (!string.IsNullOrEmpty(Model.Details))
        {
            <span class="text-muted small">— @Model.Details</span>
        }
    </div>
    <span class="tc-audit-time">@Model.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</span>
</div>
